{% extends 'front/base_front.html.twig' %}
{% block title %}Tournament{% endblock %}

{% block body %}
{% include '_ui/am_styles.html.twig' %}

<div class="am-page">
  <div class="am-shell">
    <div class="am-card">
      <div class="am-card__header">
        <div>
          <h1 class="am-title">Tournament #{{ tournament.id }}</h1>
          <div class="am-subtitle">Détails du tournoi.</div>
        </div>
        <div class="am-actions">
          <a class="am-btn" href="{{ path('am_tournament_index') }}">⬅️ Back</a>
          <a class="am-btn am-btn--primary" href="{{ path('am_tournament_edit', {'id': tournament.id}) }}">✏️ Edit</a>
        </div>
      </div>
      <div class="am-card__body">
        <table class="am-table">
          <tbody>
            <tr><th>Name</th><td>{{ tournament.name }}</td></tr>
            <tr><th>Game</th><td>{{ tournament.game ? tournament.game.name : '—' }}</td></tr>
            <tr><th>Status</th><td>{{ tournament.status }}</td></tr>
            <tr><th>Start</th><td>{{ tournament.startAt|date('Y-m-d H:i') }}</td></tr>
            <tr><th>Check-in</th><td>{{ tournament.checkInAt ? tournament.checkInAt|date('Y-m-d H:i') : '—' }}</td></tr>
            <tr><th>Slots</th><td>{{ tournament.slots }}</td></tr>
            <tr><th>Format</th><td>{{ tournament.format }}</td></tr>
            <tr><th>Prize</th><td>{{ tournament.prize }}</td></tr>
            <tr><th>Rules</th><td>{{ tournament.rules }}</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
{% endblock %}
