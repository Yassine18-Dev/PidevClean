{% extends 'front/base_front.html.twig' %}

{% block title %}Mon Panier{% endblock %}

{% block body %}
<div class="cart-page">
    <h1>🛒 Mon Panier</h1>

    {% if cart is empty %}
        <p style="text-align:center;color:#9ca3af;">Votre panier est vide.</p>
    {% else %}
        <table>
            <thead>
                <tr>
                    <th>Produit</th>
                    <th>Quantité</th>
                    <th>Prix unitaire</th>
                    <th>Total</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for cartKey, product in products %}
                    {% set quantity = cart[cartKey] %}
                    {% set size = sizes[cartKey] ?? null %}
                    {% set originalPrice = product.price %}
                    {% set finalPrice = product.getFinalPrice() %}
                    {% set lineTotalOriginal = originalPrice * quantity %}
                    {% set lineTotalFinal = finalPrice * quantity %}
                    <tr>
                        <td>
                            {{ product.name }}
                            {% if size %}
                                <span class="badge bg-secondary">{{ size.name }}</span>
                            {% endif %}
                            {% if product.hasActivePromotion() %}
                                <span class="badge bg-danger" style="margin-left: 5px;">
                                    🔥 {{ product.getFormattedDiscount() }}
                                </span>
                            {% endif %}
                        </td>
                        <td>
                            <span style="background: #f3f4f6; padding: 8px 12px; border-radius: 6px; font-weight: bold; color: #374151;">
                                {{ quantity }}
                            </span>
                        </td>
                        <td>
                            {% if product.hasActivePromotion() %}
                                <div style="text-decoration: line-through; color: #888; font-size: 0.9rem;">
                                    {{ originalPrice }} €
                                </div>
                                <div style="color: #facc15; font-weight: bold;">
                                    {{ finalPrice }} €
                                </div>
                            {% else %}
                                {{ originalPrice }} €
                            {% endif %}
                        </td>
                        <td>
                            {% if product.hasActivePromotion() %}
                                <div style="text-decoration: line-through; color: #888; font-size: 0.9rem;">
                                    {{ lineTotalOriginal }} €
                                </div>
                                <div style="color: #facc15; font-weight: bold;">
                                    {{ lineTotalFinal }} €
                                </div>
                            {% else %}
                                {{ lineTotalOriginal }} €
                            {% endif %}
                        </td>
                        <td>
                            <form method="post" action="{{ path('cart_remove', {'cartKey': cartKey}) }}" 
                                  style="display: inline;" 
                                  onsubmit="removeCartItem(event, this, '{{ cartKey }}')">
                                <input type="hidden" name="_token" value="{{ csrf_token('remove' ~ cartKey) }}">
                                <button type="submit" 
                                        class="btn btn-danger btn-sm" 
                                        style="background: #ef4444; color: white; border: none; padding: 6px 12px; border-radius: 4px; cursor: pointer; font-size: 0.9rem;"
                                        title="Supprimer cet article">
                                    🗑️
                                </button>
                            </form>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>

        {# RÉSUMÉ DES PROMOTIONS #}
        {% if has_promotions and cart_calculation %}
            <div style="background: linear-gradient(135deg, #f3f4f6, #e5e7eb); padding: 20px; border-radius: 12px; margin: 20px 0;">
                <h3 style="color: #1f2937; margin-bottom: 15px;">🎯 Résumé des Promotions</h3>
                
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px;">
                    <div style="background: white; padding: 15px; border-radius: 8px; border-left: 4px solid #ef4444;">
                        <div style="color: #6b7280; font-size: 0.9rem; margin-bottom: 5px;">Total original</div>
                        <div style="font-size: 1.5rem; font-weight: bold; color: #374151;">
                            {{ cart_calculation.total_original }} €
                        </div>
                    </div>
                    
                    <div style="background: white; padding: 15px; border-radius: 8px; border-left: 4px solid #10b981;">
                        <div style="color: #6b7280; font-size: 0.9rem; margin-bottom: 5px;">Total avec réduction</div>
                        <div style="font-size: 1.5rem; font-weight: bold; color: #059669;">
                            {{ cart_calculation.total_final }} €
                        </div>
                    </div>
                </div>
                
                <div style="background: white; padding: 15px; border-radius: 8px; border-left: 4px solid #f59e0b;">
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <div>
                            <div style="color: #6b7280; font-size: 0.9rem;">Économie réalisée</div>
                            <div style="font-size: 1.2rem; font-weight: bold; color: #d97706;">
                                -{{ cart_calculation.total_discount }} €
                            </div>
                        </div>
                        <div style="text-align: right;">
                            <div style="color: #6b7280; font-size: 0.9rem;">Pourcentage d'économie</div>
                            <div style="font-size: 1.2rem; font-weight: bold; color: #d97706;">
                                {{ cart_calculation.savings_percentage }}%
                            </div>
                        </div>
                    </div>
                </div>
                
                {# DÉTAIL DES PROMOTIONS APPLIQUÉES #}
                {% if cart_calculation.applied_promotions %}
                    <div style="margin-top: 20px;">
                        <h4 style="color: #374151; margin-bottom: 10px;">Promotions appliquées :</h4>
                        {% for promotion in cart_calculation.applied_promotions %}
                            <div style="background: white; padding: 12px; border-radius: 8px; margin-bottom: 10px; border: 1px solid #e5e7eb;">
                                <div style="font-weight: bold; color: #1f2937; margin-bottom: 5px;">
                                    🎯 {{ promotion.promotion.name }} ({{ promotion.discount }})
                                </div>
                                <div style="color: #6b7280; font-size: 0.9rem;">
                                    {{ promotion.product_count }} produit(s) concerné(s) - Économie : {{ promotion.total_discount }} €
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
        {% endif %}

        {# TOTAL FINAL #}
        {% if cart_calculation %}
            <div style="text-align: right; margin-top: 20px;">
                <div style="background: #1f2937; color: white; padding: 15px 20px; border-radius: 8px; display: inline-block;">
                    <div style="font-size: 0.9rem; opacity: 0.8; margin-bottom: 5px;">Total à payer</div>
                    <div style="font-size: 1.8rem; font-weight: bold;">
                        {{ cart_calculation.total_final }} €
                    </div>
                    {% if has_promotions %}
                        <div style="font-size: 0.8rem; opacity: 0.7; margin-top: 5px;">
                            Vous économisez {{ cart_calculation.total_discount }} € ({{ cart_calculation.savings_percentage }}%)
                        </div>
                    {% endif %}
                </div>
                
                {# BOUTON PAYER FONCTIONNEL #}
                <div style="margin-top: 15px;">
                    <a href="{{ path('payment') }}" class="btn btn-primary btn-large" style="background: linear-gradient(45deg, #10b981, #059669); color: white; border: none; padding: 15px 40px; border-radius: 8px; font-size: 1.1rem; font-weight: 600; cursor: pointer; transition: all 0.3s; text-decoration: none; box-shadow: 0 4px 6px rgba(16, 185, 129, 0.1);" onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 6px 12px rgba(16, 185, 129, 0.4)';" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 4px 6px rgba(16, 185, 129, 0.3)';">
                        � Procéder au paiement
                    </a>
                    <a href="{{ path('cart_clear') }}" class="btn btn-secondary" onclick="return confirm('Êtes-vous sûr de vouloir vider votre panier ?');">
                        🗑️ Vider le panier
                    </a>
                </div>
            </div>
        {% else %}
            <div style="text-align: right; margin-top: 20px;">
                <div style="background: #1f2937; color: white; padding: 15px 20px; border-radius: 8px; display: inline-block;">
                    <div style="font-size: 0.9rem; opacity: 0.8; margin-bottom: 5px;">Total à payer</div>
                    <div style="font-size: 1.8rem; font-weight: bold;">
                        {% set total = 0 %}
                        {% for cartKey, product in products %}
                            {% set quantity = cart[cartKey] %}
                            {% set total = total + (product.price * quantity) %}
                        {% endfor %}
                        {{ total }} €
                    </div>
                </div>
            </div>
        {% endif %}

        <!-- Modal Paiement -->
        <div id="payment-modal" class="payment-modal" style="display:none;">
            <div class="payment-box">
                <h2>💳 Paiement sécurisé</h2>
                <p class="payment-sub">Simulation de paiement </p>

                <label>Nom sur la carte</label>
                <input type="text" placeholder="MOATEZ BEN SALEM">

                <label>Numéro de carte</label>
                <input type="text" placeholder="4242 4242 4242 4242">

                <div class="payment-row">
                    <div>
                        <label>Expiration</label>
                        <input type="text" placeholder="MM/AA">
                    </div>
                    <div>
                        <label>CVC</label>
                        <input type="text" placeholder="123">
                    </div>
                </div>

                <button id="pay-btn">Payer</button>
                <button class="close-btn" id="close-payment">Annuler</button>
            </div>
        </div>
    {% endif %}
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        // Gestion du modal de paiement
        document.getElementById('show-payment-btn').addEventListener('click', function() {
            document.getElementById('payment-modal').style.display = 'block';
        });

        document.getElementById('pay-btn').addEventListener('click', function() {
            // Simuler le paiement
            alert('💳 Paiement simulé avec succès !\n\nTotal payé : ' + 
                (document.querySelector('.cart-page').querySelector('[style*="font-size: 1.8rem; font-weight: bold;"]')?.textContent || 'N/A') + 
                '\n\nMerci pour votre achat !');
            
            // Fermer le modal
            document.getElementById('payment-modal').style.display = 'none';
        });

        document.getElementById('close-payment').addEventListener('click', function() {
            document.getElementById('payment-modal').style.display = 'none';
        });

        // Fonction pour supprimer un article du panier
        function removeCartItem(event, form, cartKey) {
            event.preventDefault();
            
            if (!confirm('Êtes-vous sûr de vouloir supprimer cet article du panier ?')) {
                return;
            }

            fetch(form.action, {
                method: 'POST',
                body: new FormData(form),
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    // Supprimer la ligne du tableau
                    const row = form.closest('tr');
                    row.style.transition = 'opacity 0.3s';
                    row.style.opacity = '0';
                    
                    setTimeout(() => {
                        row.remove();
                        
                        // Mettre à jour les totaux
                        updateCartTotals(data);
                        
                        // Mettre à jour le slider du panier s'il existe
                        updateCartSlider(data);
                        
                        // Si le panier est vide, recharger la page
                        if (data.count === 0) {
                            setTimeout(() => {
                                location.reload();
                            }, 500);
                        }
                    }, 300);
                } else {
                    alert('Erreur lors de la suppression de l\'article');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Erreur technique lors de la suppression');
            });
        }

        // Mettre à jour les totaux du panier
        function updateCartTotals(data) {
            // Mettre à jour le total affiché
            const totalElements = document.querySelectorAll('[style*="font-size: 1.8rem; font-weight: bold;"]');
            totalElements.forEach(element => {
                if (element.textContent.includes('€')) {
                    element.textContent = data.total + ' €';
                }
            });

            // Mettre à jour le compteur d'articles dans le header si présent
            const cartCounters = document.querySelectorAll('.cart-counter, .cart-count');
            cartCounters.forEach(counter => {
                counter.textContent = data.count;
            });
        }

        // Mettre à jour le slider du panier (s'il existe sur la page)
        function updateCartSlider(data) {
            // Chercher le slider du panier dans les autres composants
            const cartSlider = document.querySelector('.cart-slider, .cart-items, .mini-cart');
            if (cartSlider) {
                // Envoyer un événement personnalisé pour mettre à jour le slider
                const event = new CustomEvent('cartUpdated', {
                    detail: {
                        count: data.count,
                        total: data.total,
                        items: data.items || []
                    }
                });
                document.dispatchEvent(event);
            }
        }

        // Écouter les mises à jour du panier
        document.addEventListener('cartUpdated', function(event) {
            const cartData = event.detail;
            console.log('Panier mis à jour:', cartData);
            
            // Mettre à jour l'affichage du slider si nécessaire
            const sliderContent = document.querySelector('.cart-slider-content');
            if (sliderContent) {
                if (cartData.count === 0) {
                    sliderContent.innerHTML = '<div class="text-center p-4"><p>Votre panier est vide</p></div>';
                } else {
                    // Mettre à jour le contenu avec les nouvelles données
                    updateSliderContent(cartData);
                }
            }
        });

        function updateSliderContent(cartData) {
            // Logique pour mettre à jour le contenu du slider
            // À implémenter selon la structure exacte du slider
            console.log('Mise à jour du slider avec:', cartData);
        }
    </script>
{% endblock %}
