{% extends 'front/base_front.html.twig' %}
{% block title %}ArenaMind • Profile{% endblock %}

{% block body %}
<style>
  .p3{display:grid;grid-template-columns: 280px 1fr 320px; gap:14px;}
  .card{background:rgba(11,15,46,.55); border:1px solid rgba(49,46,129,.55); border-radius:16px; padding:14px;}
  .muted{color:var(--muted);}
  .row{display:flex; align-items:center; justify-content:space-between; gap:10px;}
  .avatar{width:64px;height:64px;border-radius:16px; object-fit:cover; border:1px solid rgba(255,255,255,.08)}
  .pill{display:inline-flex;align-items:center; gap:8px; padding:6px 10px; border-radius:999px; border:1px solid rgba(49,46,129,.55); background:rgba(5,8,20,.45); font-weight:900; font-size:12px;}
  .badgeCount{display:inline-flex; align-items:center; justify-content:center; width:20px;height:20px;border-radius:999px; background:linear-gradient(90deg,var(--purple),var(--blue)); font-size:12px; font-weight:1000;}
  .btn{display:inline-flex; align-items:center; justify-content:center; padding:10px 14px; border-radius:14px; text-decoration:none; font-weight:900; font-size:13px; border:1px solid rgba(49,46,129,.55); background:rgba(5,8,20,.45); color:#fff;}
  .btn:hover{opacity:.95}
  .btnPrimary{border:none; background:linear-gradient(90deg,var(--purple),var(--blue));}
  .btnDanger{border:none; background:linear-gradient(90deg,#ef4444,#b91c1c);}
  .list{display:flex; flex-direction:column; gap:10px;}
  .item{padding:12px; border-radius:16px; border:1px solid rgba(49,46,129,.45); background:rgba(5,8,20,.45);}
  .actions{display:flex; gap:10px; flex-wrap:wrap; margin-top:10px;}
  .sectionTitle{display:flex; align-items:center; justify-content:space-between; gap:10px; font-weight:1000;}
  .mini{font-size:12px;}
  @media(max-width: 980px){.p3{grid-template-columns: 1fr;}}
</style>

<div class="row" style="margin-bottom:14px;">
  <div>
    <h1 style="margin:0; font-size:22px;">Mon Profil</h1>
    <div class="muted" style="font-size:13px; margin-top:6px;">Profil 3 colonnes + invitations</div>
  </div>
  <div style="display:flex; gap:10px; flex-wrap:wrap;">
    <a class="btn" href="{{ path('ui_profile_edit') }}">✏️ Edit</a>
    <a class="btn" href="{{ path('invitation_index') }}">🔔 Invitations {% if receivedInvitations|length > 0 %}<span class="badgeCount">{{ receivedInvitations|length }}</span>{% endif %}</a>
  </div>
</div>

<div class="p3">
  {# LEFT #}
  <div class="card">
    <div class="row" style="align-items:flex-start;">
      {% if player and player.avatarName %}
        <img class="avatar" src="{{ asset('images/player-avatars/' ~ player.avatarName) }}" alt="avatar">
      {% else %}
        <div class="avatar" style="display:flex;align-items:center;justify-content:center;">👤</div>
      {% endif %}
      <div style="flex:1;">
        <div style="font-weight:1000; font-size:16px;">{{ player ? player.nickname : user.username }}</div>
        <div class="muted" style="font-size:13px;">
          {{ player ? (player.game|upper ~ (player.rank ? ' • ' ~ player.rank : '')) : (user.favoriteGame ?: '—') }}
        </div>
      </div>
    </div>

    <div style="margin-top:12px; display:flex; flex-wrap:wrap; gap:8px;">
      <span class="pill">Role: {{ user.roleType }}</span>
      <span class="pill">Status: {{ user.status }}</span>
    </div>

    <div style="margin-top:12px;" class="muted">
      <div><strong>Email:</strong> {{ user.email }}</div>
      <div><strong>Registered:</strong> {{ user.createdAt|date('Y-m-d') }}</div>
    </div>

    {# ✅ SECTION DISCORD #}
    <div class="item" style="margin-top:14px;">
      <div class="sectionTitle">
        <div>🔗 Comptes connectés</div>
      </div>

      <div class="item" style="margin-top:10px;">
        <div class="sectionTitle">
          <div>🟦 Discord</div>
          {% if player and player.discordId %}
            <span class="pill">Connecté</span>
          {% else %}
            <span class="pill">Non connecté</span>
          {% endif %}
        </div>

        <div class="muted mini" style="margin-top:8px; line-height:1.6;">
          {% if player and player.discordId %}
            <div><strong>Connecté :</strong> {{ player.discordUsername ?? ('Utilisateur#' ~ player.discordId) }}</div>
            <div><strong>ID :</strong> {{ player.discordId }}</div>
          {% else %}
            <div>Non connecté</div>
          {% endif %}
        </div>

        <div class="actions">
          {% if player and player.discordId %}
            <a class="btn btnDanger" href="{{ path('disconnect_discord') }}"><i class="fa-solid fa-right-from-bracket"></i>&nbsp;Déconnecter</a>
          {% else %}
            <a class="btn btnPrimary" href="{{ path('connect_discord') }}"><i class="fa-brands fa-discord"></i>&nbsp;Se connecter avec Discord</a>
          {% endif %}
        </div>
      </div>

      <div class="item" style="margin-top:10px;">
        <div class="sectionTitle">
          <div>🎮 Riot</div>
          {% if player and player.riotGameName %}
            <span class="pill">Connecté</span>
          {% else %}
            <span class="pill">Non connecté</span>
          {% endif %}
        </div>
        <div class="muted mini" style="margin-top:8px; line-height:1.6;">
          {% if player and player.riotGameName %}
            <div><strong>Connecté :</strong> {{ player.riotGameName }}{% if player.riotTagLine %}#{{ player.riotTagLine }}{% endif %}</div>
          {% else %}
            <div>Non connecté</div>
          {% endif %}
        </div>
      </div>
    </div>

    <div class="actions">
      <a class="btn btnPrimary" href="{{ path('app_player_index') }}">👥 Players</a>
      <a class="btn" href="{{ path('app_team_index') }}">🛡️ Teams</a>
    </div>
  </div>

  {# CENTER #}
  <div class="card">
    <h2 style="margin:0 0 8px; font-size:16px;">Centre</h2>
    <div class="muted" style="font-size:13px; line-height:1.6;">
      Ici tu peux brancher tes stats (matchs / winrate / KDA) et challenges.
    </div>

    <div style="margin-top:14px;" class="item">
      <div class="row">
        <div style="font-weight:1000;">🔔 Invitations</div>
        {% if receivedInvitations|length > 0 %}<span class="badgeCount">{{ receivedInvitations|length }}</span>{% endif %}
      </div>
      <div class="muted" style="font-size:13px; margin-top:6px;">Accéder à la liste complète et répondre.</div>
      <div class="actions">
        <a class="btn" href="{{ path('invitation_index') }}">Voir mes invitations</a>
      </div>
    </div>

    <div style="margin-top:12px;" class="item">
      <div style="font-weight:1000;">Équipe actuelle</div>
      <div class="muted" style="font-size:13px; margin-top:6px;">
        {% if player and player.team %}
          {{ player.team.name }} ({{ player.team.game|upper }})
        {% else %}
          Aucune équipe pour le moment.
        {% endif %}
      </div>
      <div class="actions">
        {% if player and player.team %}
          <a class="btn" href="{{ path('app_team_show', {id: player.team.id}) }}">Voir équipe →</a>
        {% else %}
          <a class="btn" href="{{ path('app_team_new') }}">Créer une équipe</a>
        {% endif %}
      </div>
    </div>
  </div>

  {# RIGHT #}
  <div class="card">
    <div class="row" style="margin-bottom:8px;">
      <h2 style="margin:0; font-size:16px;">Notifications</h2>
      <a class="btn" href="{{ path('invitation_index') }}">Tout voir →</a>
    </div>

    <div class="list">
      {% for inv in receivedInvitations|slice(0,2) %}
        <div class="item">
          <div style="font-weight:1000;">{{ inv.team.name }} t'invite</div>
          <div class="muted" style="font-size:12px; margin-top:6px;">Demandé le {{ inv.createdAt|date('d/m/Y') }}</div>
          <div class="actions">
            <form method="post" action="{{ path('invitation_accept', {id: inv.id}) }}">
              <button class="btn btnPrimary" type="submit">✓</button>
            </form>
            <form method="post" action="{{ path('invitation_decline', {id: inv.id}) }}">
              <button class="btn" type="submit">✗</button>
            </form>
            <a class="btn" href="{{ path('app_team_show', {id: inv.team.id}) }}">Voir</a>
          </div>
        </div>
      {% else %}
        <div class="muted">Aucune invitation.</div>
      {% endfor %}
    </div>
  </div>
</div>
{% endblock %}