{% extends 'front/base_front.html.twig' %}
{% block title %}ArenaMind • Upcoming Tournaments{% endblock %}

{% block body %}
<style>
  .section-header{margin-bottom:22px;}
  .section-header h1{font-size:26px;margin:0 0 6px;color:var(--purple);}
  .section-header p{color:var(--muted);font-size:13px;margin:0;}
  .tourney-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(340px,1fr));gap:18px;margin-bottom:28px;}
  .tourney-card{background:rgba(11,15,46,.55);border:1px solid rgba(49,46,129,.55);border-radius:16px;padding:20px;transition:transform .15s,border-color .2s;}
  .tourney-card:hover{transform:translateY(-3px);border-color:var(--purple);}
  .tourney-card .game-badge{display:inline-block;padding:5px 12px;border-radius:999px;background:rgba(168,85,247,.15);border:1px solid rgba(168,85,247,.3);font-size:11px;font-weight:700;color:#c4b5fd;margin-bottom:10px;}
  .tourney-card h3{margin:0 0 6px;font-size:18px;}
  .tourney-card .meta{color:var(--muted);font-size:13px;margin-bottom:12px;}
  .tourney-details{display:flex;gap:18px;flex-wrap:wrap;font-size:13px;margin-bottom:10px;}
  .tourney-details div strong{display:block;font-size:12px;color:#cbd5f5;margin-bottom:2px;}
  .tourney-actions{display:flex;gap:8px;margin-top:10px;}
  .tourney-actions a{padding:8px 14px;border-radius:12px;text-decoration:none;font-weight:700;font-size:12px;color:#fff;border:1px solid rgba(49,46,129,.55);background:rgba(5,8,20,.45);}
  .tourney-actions a.primary{background:linear-gradient(135deg,#7C3AED,#a855f7);border:none;}
  .manage-bar{display:flex;justify-content:space-between;align-items:center;margin-top:22px;padding-top:16px;border-top:1px solid rgba(49,46,129,.35);}
  .manage-bar a.manage-btn{display:inline-flex;align-items:center;gap:8px;padding:12px 20px;border-radius:14px;text-decoration:none;font-weight:900;font-size:14px;color:#fff;background:linear-gradient(135deg,#7C3AED,#a855f7);border:none;transition:transform .1s;}
  .manage-bar a.manage-btn:hover{transform:translateY(-2px);}
  .back-link{color:var(--muted);text-decoration:none;font-size:13px;font-weight:700;}
  .back-link:hover{color:#fff;}
  .status-badge{display:inline-block;padding:4px 10px;border-radius:999px;font-size:11px;font-weight:700;margin-bottom:8px;}
  .status-scheduled{background:rgba(59,130,246,.15);border:1px solid rgba(59,130,246,.3);color:#93c5fd;}
  .status-open{background:rgba(34,197,94,.12);border:1px solid rgba(34,197,94,.3);color:#86efac;}
  .status-closed{background:rgba(239,68,68,.12);border:1px solid rgba(239,68,68,.3);color:#fca5a5;}
  .empty-state{text-align:center;padding:40px;color:var(--muted);}
  .empty-state .icon{font-size:48px;margin-bottom:12px;}
</style>

<div class="section-header">
  <h1>🏆 Upcoming Tournaments</h1>
  <p>Tous les tournois disponibles sur ArenaMind.</p>
</div>

<div class="tourney-grid">
  {% for tournament in tournaments %}
    <div class="tourney-card">
      <span class="game-badge">🎮 {{ tournament.game ? tournament.game.name : '—' }}</span>
      <h3>{{ tournament.name }}</h3>
      <div class="meta">{{ tournament.slots }} slots disponibles</div>
      <div class="tourney-details">
        <div>
          <strong>Début</strong>
          {{ tournament.startAt|date('d/m/Y') }}<br>
          <small style="color:var(--muted);">{{ tournament.startAt|date('H:i') }}</small>
        </div>

        {% if tournament.checkInAt %}
          <div>
            <strong>Check-in</strong>
            {{ tournament.checkInAt|date('d/m/Y') }}<br>
            <small style="color:var(--muted);">{{ tournament.checkInAt|date('H:i') }}</small>
          </div>
        {% endif %}

        <div><strong>Format</strong>{{ tournament.format }}</div>
      </div>

      <div class="tourney-actions">
        <a class="primary" href="{{ path('am_tournament_show', {id: tournament.id}) }}">Voir détails</a>
      </div>
    </div>
  {% else %}
    <div class="empty-state" style="grid-column:1/-1;">
      <div class="icon">🏟️</div>
      <p>Aucun tournoi disponible pour le moment.</p>
      <a href="{{ path('am_tournament_new') }}"
         style="display:inline-block;padding:10px 20px;border-radius:12px;background:linear-gradient(135deg,#7C3AED,#a855f7);color:#fff;text-decoration:none;font-weight:700;margin-top:12px;">
        + Créer un tournoi
      </a>
    </div>
  {% endfor %}
</div>

<div class="manage-bar">
  {# ✅ FIX: ui_home n'existe pas -> front_home #}
  <a class="back-link" href="{{ path('front_home') }}">← Retour à l'accueil</a>

  <a class="manage-btn" href="{{ path('am_tournament_index') }}">⚙️ Manage Tournaments</a>
</div>
{% endblock %}