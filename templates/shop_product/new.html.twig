{# shop_product/new.html.twig #}
{% extends 'front/base_front.html.twig' %}

{% block title %}Ajouter un produit{% endblock %}

{% block body %}
<h1>Ajouter un produit</h1>

{{ form_start(form) }}
    {{ form_row(form.name) }}
    {{ form_row(form.price) }}
    {{ form_row(form.type) }}
    {{ form_row(form.game) }}
    {{ form_row(form.image) }}
    
    {{ form_row(form.imagesFiles) }}
    {% if form.type.vars.value == 'merch' %}
    {{ form_row(form.sizes) }}
    {% endif %}
    
    {# Affichage des erreurs globales #}
    {% if form.vars.errors|length > 0 %}
        <div class="alert alert-danger">
            <ul>
                {% for error in form.vars.errors %}
                    <li>{{ error.message }}</li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}
    
    <button class="btn btn-primary">Ajouter</button>
{{ form_end(form) }}

<a href="{{ path('app_shop_product_index') }}">Retour à la liste</a>
{% endblock %}
