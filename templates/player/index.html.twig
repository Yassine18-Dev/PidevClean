{% extends 'front/base_front.html.twig' %}

{% block title %}Players{% endblock %}

{% block body %}
<div class="am-container" style="max-width:1100px; margin:24px auto;">
  <div class="am-card">
    <div class="am-card__head" style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px;">
      <div style="font-weight:900; font-size:20px;">👥 Players</div>
      <div class="mb-3" style="margin-bottom:0 !important;">
          <a href="{{ path('profile_index') }}" class="btn btn-outline-secondary" style="display:inline-flex; align-items:center; gap:8px; padding:8px 16px; border-radius:8px; border:1px solid rgba(255,255,255,0.2); color:#fff; text-decoration:none;">
              <i class="fas fa-arrow-left"></i> Retour au profil
          </a>
      </div>
    </div>

    <div class="am-card__body">
      {% if users is empty %}
        <div style="opacity:.85;">No users found.</div>
      {% else %}
        <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(260px, 1fr)); gap:10px;">
          {% for user in users %}
            {% set player = user.player %}
            
            <div class="am-pcard" style="display:flex; flex-direction:column; gap:10px;">
              <div style="display:flex; gap:12px; align-items:center;">
                {% if player and player.avatarName %}
                  <img src="{{ asset('images/player-avatars/' ~ player.avatarName) }}" class="avatarMini" style="width:48px; height:48px; object-fit:cover; border-radius:12px;">
                {% else %}
                  <div class="avatarMini" style="width:48px; height:48px; font-size:20px;">👤</div>
                {% endif %}
                
                <div>
                  <div style="font-weight:1000; font-size:16px;">
                    {{ player ? player.nickname : user.username }}
                  </div>
                  {% if player %}
                    {% if player.team %}
                      <div style="font-size:12px; color:#a5b4fc; margin-top:2px;"><i class="fas fa-shield-alt"></i> {{ player.team.name }}</div>
                    {% else %}
                      <div style="font-size:12px; opacity:0.5; margin-top:2px;">Sans équipe</div>
                    {% endif %}
                  {% else %}
                    <div style="font-size:12px; opacity:0.5; margin-top:2px;">Joueur standard</div>
                  {% endif %}
                </div>
              </div>

              {% if player %}
              <div style="font-size:13px; margin-top:4px;">
                {% if player.riotTier %}
                  🏆 <span style="font-weight:bold;">{{ player.riotTier }} {{ player.riotDivision }}</span> <span style="opacity:0.7;">({{ player.riotLp }} LP)</span>
                {% elseif player.riotRank %}
                  🏆 <span style="font-weight:bold;">{{ player.riotRank }}</span>
                {% else %}
                  <span style="opacity:0.5;">Non classé</span>
                {% endif %}
              </div>

              <div style="display:flex; gap:8px; margin-top:4px;">
                {% if player.discordId %}
                  <span style="background:rgba(114,137,218,0.15); color:#7289da; padding:4px 10px; border-radius:12px; font-size:11px; font-weight:bold;"><i class="fab fa-discord"></i> Discord</span>
                {% endif %}
                {% if player.riotPuuid %}
                  <span style="background:rgba(235,0,41,0.15); color:#eb0029; padding:4px 10px; border-radius:12px; font-size:11px; font-weight:bold;"><i class="fas fa-gamepad"></i> Riot</span>
                {% endif %}
              </div>
              {% endif %}

              <div style="margin-top:auto; padding-top:12px; display:flex; gap:8px;">
                {% if player %}
                    <a class="btnSmall" style="flex:1; text-align:center; background:rgba(255,255,255,0.05);" href="{{ path('app_player_show', {id: player.id}) }}">👤 Voir</a>
                {% else %}
                    <button disabled class="btnSmall" style="flex:1; text-align:center; background:rgba(255,255,255,0.05); opacity:0.5; cursor:not-allowed;">👤 Voir</button>
                {% endif %}
                <button class="btnSmall" style="flex:1; text-align:center; background:rgba(239,68,68,0.15); color:#fca5a5; border-color:rgba(239,68,68,0.2); cursor:pointer;">⚔️ Challenge</button>
              </div>
            </div>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
</div>

<style>
  .am-pcard{
    background: rgba(255,255,255,.04);
    border: 1px solid rgba(255,255,255,.08);
    border-radius: 12px;
    padding: 12px;
    transition: transform .15s ease, box-shadow .15s ease;
  }
  .am-pcard:hover{
    transform: scale(1.01);
    box-shadow: 0 0 18px rgba(0,168,255,.14);
  }
  .avatarMini{
    width:42px;height:42px;border-radius:12px;
    display:flex; align-items:center; justify-content:center;
    background: rgba(255,255,255,.05);
    border:1px solid rgba(255,255,255,.08);
  }
  .pill{
    display:inline-flex; align-items:center; gap:6px;
    padding:6px 10px;
    border-radius:999px;
    border:1px solid rgba(255,255,255,.10);
    background: rgba(0,0,0,.18);
    font-weight:800;
    font-size:12px;
  }
  .pillMuted{ opacity:.75; }
  .pillDiscord{ border-color: rgba(145,71,255,.35); }
  .btnSmall{
    display:inline-flex; align-items:center; justify-content:center;
    padding:8px 10px; border-radius:10px;
    border:1px solid rgba(255,255,255,.10);
    background: rgba(0,0,0,.25);
    color:#fff; text-decoration:none; font-weight:900;
    transition: transform .15s ease, box-shadow .15s ease;
  }
  .btnSmall:hover{transform:scale(1.02); box-shadow:0 0 14px rgba(0,168,255,.14);}
</style>
{% endblock %}