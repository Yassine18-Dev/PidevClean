{% extends 'front/base_front.html.twig' %}
{% block title %}Players{% endblock %}

{% block body %}
<style>
  .wrap{max-width:1200px;margin:0 auto;}
  .topbar{display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:14px;}
  .btn{display:inline-flex;align-items:center;gap:8px;padding:10px 14px;border-radius:14px;border:1px solid rgba(49,46,129,.55);background:rgba(5,8,20,.45);color:#fff;text-decoration:none;font-weight:900;font-size:13px;}
  .btn:hover{opacity:.95}
  .btnPrimary{border:none;background:linear-gradient(90deg,var(--purple),var(--blue));}
  .card{background:rgba(11,15,46,.55);border:1px solid rgba(49,46,129,.55);border-radius:18px;padding:16px;box-shadow:0 0 40px rgba(168,85,247,.10);}
  .muted{color:var(--muted);}
  .toolbar{display:flex;gap:10px;flex-wrap:wrap;align-items:center;justify-content:space-between;margin-bottom:14px;}
  .input, .select{padding:12px;border-radius:14px;border:1px solid rgba(49,46,129,.55);background:#0b0f2e;color:#fff;outline:none;}
  .grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;}
  .pCard{padding:14px;}
  .avatar{width:78px;height:78px;border-radius:18px;object-fit:cover;border:1px solid rgba(255,255,255,.08)}
  .pill{display:inline-flex;align-items:center;gap:6px;padding:6px 10px;border-radius:999px;border:1px solid rgba(49,46,129,.55);background:rgba(5,8,20,.45);font-weight:900;font-size:12px;}
  .actions{display:flex;gap:8px;justify-content:center;flex-wrap:wrap;margin-top:12px;}
  @media(max-width:1200px){.grid{grid-template-columns:repeat(3,1fr);}}
  @media(max-width:980px){.grid{grid-template-columns:repeat(2,1fr);}}
  @media(max-width:560px){.grid{grid-template-columns:1fr;}}
</style>

<div class="wrap">
  <div class="topbar">
    <a class="btn" href="{{ path('ui_profile') }}"><i class="fa-solid fa-arrow-left"></i> Retour au profil</a>
    <div style="text-align:center;flex:1;min-width:240px;">
      <h1 style="margin:0;font-size:20px;"># JOUEURS</h1>
      <div class="muted" style="font-size:13px;margin-top:6px;">Recherche & tri</div>
    </div>
    {# ✅ on supprime le bouton Nouveau Player #}
    <div style="width:140px;"></div>
  </div>

  <div class="card" style="margin-bottom:14px;">
    <div class="toolbar">
      <form method="get" style="display:flex;gap:10px;flex-wrap:wrap;align-items:center;">
        <input class="input" type="text" name="q" value="{{ q|default('') }}" placeholder="Rechercher (player ou team)..." />
        <select class="select" name="sort">
          <option value="id" {{ (sort|default('id')) == 'id' ? 'selected' : '' }}>Tri: ID</option>
          <option value="name" {{ (sort|default('id')) == 'name' ? 'selected' : '' }}>Tri: Pseudo</option>
          <option value="team" {{ (sort|default('id')) == 'team' ? 'selected' : '' }}>Tri: Team</option>
        </select>
        <select class="select" name="dir">
          <option value="asc" {{ (dir|default('asc')) == 'asc' ? 'selected' : '' }}>ASC</option>
          <option value="desc" {{ (dir|default('asc')) == 'desc' ? 'selected' : '' }}>DESC</option>
        </select>
        <button class="btn" type="submit"><i class="fa-solid fa-filter"></i> Appliquer</button>
        {% if (q|default('')) or (sort|default('id')) != 'id' or (dir|default('asc')) != 'asc' %}
          <a class="btn" href="{{ path('app_player_index') }}">Reset</a>
        {% endif %}
      </form>

      <span class="pill">{{ players|length }} résultat(s)</span>
    </div>
  </div>

  <div class="grid">
    {% for player in players %}
      <div class="card pCard">
        <div style="text-align:center;">
          {% if player.avatarName %}
            <img class="avatar" src="{{ asset('images/player-avatars/' ~ player.avatarName) }}" alt="{{ player.nickname }}">
          {% else %}
            <div class="avatar" style="display:flex;align-items:center;justify-content:center;margin:0 auto;">👤</div>
          {% endif %}

          <div style="margin-top:10px;font-weight:1000;">{{ player.nickname }}</div>
          <div class="muted" style="font-size:12px;margin-top:6px;">
            {{ player.game|upper }}{% if player.rank %} • {{ player.rank }}{% endif %}
          </div>

          <div style="margin-top:10px;display:flex;gap:8px;justify-content:center;flex-wrap:wrap;">
            {% if player.team %}
              <span class="pill"><i class="fa-solid fa-users"></i> {{ player.team.name }}</span>
            {% else %}
              <span class="pill"><i class="fa-solid fa-user"></i> Sans équipe</span>
            {% endif %}

            {% if player.discordId %}
              <span class="pill"><i class="fa-brands fa-discord"></i> ✓</span>
            {% else %}
              <span class="pill"><i class="fa-brands fa-discord"></i> ✗</span>
            {% endif %}
          </div>

          <div class="actions">
            <a class="btn" href="{{ path('app_player_show', {'id': player.id}) }}" title="Voir"><i class="fa-solid fa-user"></i></a>
            <a class="btn" href="#" title="Défier">⚔️</a>
            {# edit seulement si admin ou soi-même #}
            {% if is_granted('ROLE_ADMIN') or (app.user and app.user.player and app.user.player.id == player.id) %}
              <a class="btn" href="{{ path('app_player_edit', {'id': player.id}) }}" title="Modifier"><i class="fa-solid fa-pen"></i></a>
            {% endif %}
          </div>
        </div>
      </div>
    {% else %}
      <div class="card" style="grid-column:1/-1;text-align:center;">
        <div class="muted">Aucun joueur trouvé.</div>
      </div>
    {% endfor %}
  </div>
</div>
{% endblock %}