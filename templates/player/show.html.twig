{% extends 'front/base_front.html.twig' %}
{% block title %}Player • {{ player.nickname }}{% endblock %}

{% block body %}
<style>
  .wrap{max-width:1100px;margin:0 auto;}
  .topbar{display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:14px;}
  .btn{display:inline-flex;align-items:center;gap:8px;padding:10px 14px;border-radius:14px;border:1px solid rgba(49,46,129,.55);background:rgba(5,8,20,.45);color:#fff;text-decoration:none;font-weight:900;font-size:13px;}
  .btn:hover{opacity:.95}
  .btnPrimary{border:none;background:linear-gradient(90deg,var(--purple),var(--blue));}
  .card{background:rgba(11,15,46,.55);border:1px solid rgba(49,46,129,.55);border-radius:18px;padding:16px;box-shadow:0 0 40px rgba(168,85,247,.10);}
  .muted{color:var(--muted);}
  .grid{display:grid;grid-template-columns: 340px 1fr; gap:14px;}
  .avatar{width:92px;height:92px;border-radius:18px;object-fit:cover;border:1px solid rgba(255,255,255,.08)}
  .pill{display:inline-flex;align-items:center;gap:6px;padding:6px 10px;border-radius:999px;border:1px solid rgba(49,46,129,.55);background:rgba(5,8,20,.45);font-weight:900;font-size:12px;}
  .row{display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;}
  .item{padding:12px;border-radius:16px;border:1px solid rgba(49,46,129,.45);background:rgba(5,8,20,.45);}
  @media(max-width:980px){.grid{grid-template-columns:1fr;}}
</style>

<div class="wrap">
  <div class="topbar">
    <a class="btn" href="{{ path('app_player_index') }}"><i class="fa-solid fa-arrow-left"></i> Retour joueurs</a>
    <a class="btn" href="{{ path('ui_profile') }}"><i class="fa-solid fa-arrow-left"></i> Retour au profil</a>
    {% if is_granted('ROLE_ADMIN') or (app.user and app.user.player and app.user.player.id == player.id) %}
      <a class="btn btnPrimary" href="{{ path('app_player_edit', {'id': player.id}) }}"><i class="fa-solid fa-pen"></i> Edit</a>
    {% endif %}
  </div>

  <div class="grid">
    <div class="card">
      <div class="row" style="align-items:flex-start;">
        {% if player.avatarName %}
          <img class="avatar" src="{{ asset('images/player-avatars/' ~ player.avatarName) }}" alt="{{ player.nickname }}">
        {% else %}
          <div class="avatar" style="display:flex;align-items:center;justify-content:center;">👤</div>
        {% endif %}
        <div style="flex:1;">
          <div style="font-weight:1000;font-size:18px;">{{ player.nickname }}</div>
          <div class="muted" style="margin-top:6px;font-size:13px;">
            {{ player.game|upper }}{% if player.rank %} • {{ player.rank }}{% endif %}
          </div>
          <div style="margin-top:10px;display:flex;gap:8px;flex-wrap:wrap;">
            {% if player.team %}
              <span class="pill"><i class="fa-solid fa-users"></i> {{ player.team.name }}</span>
            {% else %}
              <span class="pill"><i class="fa-solid fa-user"></i> Sans équipe</span>
            {% endif %}
            {% if player.discordId %}
              <span class="pill"><i class="fa-brands fa-discord"></i> Discord ✓</span>
            {% else %}
              <span class="pill"><i class="fa-brands fa-discord"></i> Discord ✗</span>
            {% endif %}
          </div>
        </div>
      </div>

      <div class="item" style="margin-top:14px;">
        <div style="font-weight:1000;margin-bottom:8px;">🟦 Discord</div>
        {% if player.discordId %}
          <div class="muted" style="font-size:13px;line-height:1.6;">
            <div><strong>Username :</strong> {{ player.discordUsername ?? ('Utilisateur#' ~ player.discordId) }}</div>
            <div><strong>ID :</strong> {{ player.discordId }}</div>
          </div>
        {% else %}
          <div class="muted">Non connecté</div>
        {% endif %}
      </div>
    </div>

    <div class="card">
      <div style="font-weight:1000;margin-bottom:10px;">📌 Informations</div>

      <div class="item">
        <div class="row">
          <div class="muted">ID</div>
          <div style="font-weight:1000;">{{ player.id }}</div>
        </div>
      </div>

      <div class="item" style="margin-top:10px;">
        <div class="row">
          <div class="muted">Jeu</div>
          <div style="font-weight:1000;">{{ player.game|upper }}</div>
        </div>
      </div>

      <div class="item" style="margin-top:10px;">
        <div class="row">
          <div class="muted">Rank</div>
          <div style="font-weight:1000;">{{ player.rank ?: '—' }}</div>
        </div>
      </div>

      <div class="item" style="margin-top:10px;">
        <div class="row">
          <div class="muted">Équipe</div>
          <div style="font-weight:1000;">
            {% if player.team %}
              <a class="btn" href="{{ path('app_team_show', {'id': player.team.id}) }}">Voir {{ player.team.name }}</a>
            {% else %}
              —
            {% endif %}
          </div>
        </div>
      </div>

      <div style="margin-top:14px;">
        <a class="btn" href="#" title="Défier">⚔️ Défi</a>
      </div>
    </div>
  </div>
</div>
{% endblock %}