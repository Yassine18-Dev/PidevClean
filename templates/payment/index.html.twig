{% extends 'front/base_front.html.twig' %}

{% block title %}Paiement Sécurisé{% endblock %}

{% block body %}
<div class="payment-page">
    <div class="container">
        <h1>💳 Paiement Sécurisé</h1>
        
        {% if cart is empty %}
            <div class="alert alert-warning">
                <p>Votre panier est vide. <a href="{{ path('app_shop_product_index') }}">Ajoutez des produits</a></p>
            </div>
        {% else %}
            <form class="payment-form" method="post" action="{{ path('payment_process') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('payment_form') }}">
                
                <div class="payment-section">
                    <h3>📋 Informations de carte</h3>
                    
                    <div class="form-row">
                        <div class="form-group">
                            <label for="cardNumber" class="form-label">Numéro de carte</label>
                            <input type="text" id="cardNumber" name="cardNumber" class="form-control" 
                                   placeholder="1234 5678 9012 3456" maxlength="19" required>
                            <div class="error-message card-number-error" style="display: none;"></div>
                        </div>
                        
                        <div class="form-group">
                            <label for="cardHolder" class="form-label">Nom du titulaire</label>
                            <input type="text" id="cardHolder" name="cardHolder" class="form-control" 
                                   placeholder="MOATEZ BEN SALEM" maxlength="50" required>
                            <div class="error-message card-holder-error" style="display: none;"></div>
                        </div>
                    </div>
                    
                    <div class="form-row">
                        <div class="form-group">
                            <label for="expiryDate" class="form-label">Date d'expiration</label>
                            <input type="text" id="expiryDate" name="expiryDate" class="form-control" 
                                   placeholder="MM/AA" maxlength="5" required>
                            <div class="error-message expiry-date-error" style="display: none;"></div>
                        </div>
                        
                        <div class="form-group">
                            <label for="cvv" class="form-label">CVC</label>
                            <input type="text" id="cvv" name="cvv" class="form-control" 
                                   placeholder="123" maxlength="4" required>
                            <div class="error-message cvv-error" style="display: none;"></div>
                        </div>
                    </div>
                    
                    <div class="form-row">
                        <div class="form-group">
                            <input type="checkbox" id="saveCard" name="saveCard" class="form-check-input">
                            <label for="saveCard" class="form-label checkbox">Enregistrer cette carte pour les prochains paiements</label>
                        </div>
                    </div>
                </div>
                
                <div class="payment-section">
                    <h3>📄 Montant à payer</h3>
                    <div class="amount-display">
                        {% if cartCalculation %}
                            <div class="amount-info">
                                <span class="amount-label">Total original :</span>
                                <span class="amount-value">{{ cartCalculation.total_original }} €</span>
                            </div>
                            
                            {% if cartCalculation.total_discount > 0 %}
                                <div class="amount-info discount">
                                    <span class="amount-label">Réduction :</span>
                                    <span class="amount-value discount-amount">-{{ cartCalculation.total_discount }} €</span>
                                </div>
                            {% endif %}
                            
                            <div class="amount-info final">
                                <span class="amount-label">Total à payer :</span>
                                <span class="amount-value final-amount">{{ cartCalculation.total_final }} €</span>
                            </div>
                            
                            {% if cartCalculation.savings_percentage > 0 %}
                                <div class="savings-info">
                                    <span class="savings-label">💰 Économie :</span>
                                    <span class="savings-value">{{ cartCalculation.savings_percentage }}%</span>
                                </div>
                            {% endif %}
                        {% else %}
                            <div class="amount-info">
                                <span class="amount-value">0 €</span>
                            </div>
                        {% endif %}
                    </div>
                </div>
                
                <div class="payment-section">
                    <h3>📋 Conditions générales</h3>
                    <div class="form-group">
                        <input type="checkbox" id="terms" name="terms" class="form-check-input" required>
                        <label for="terms" class="form-label checkbox">J'accepte les conditions générales de vente</label>
                    </div>
                </div>
                
                <input type="hidden" name="amount" value="{{ cartCalculation.total_final ?? 0 }}">
                
                <div class="form-actions">
                    <button type="submit" class="btn btn-primary btn-large" id="submitBtn">
                        🔒 Payer {{ cartCalculation.total_final ?? 0 }} €
                    </button>
                    <a href="{{ path('cart_show') }}" class="btn btn-secondary">
                        ← Retour au panier
                    </a>
                </div>
            </form>
        {% endif %}
    </div>
</div>

<style>
.payment-page {
    max-width: 800px;
    margin: 0 auto;
    padding: 20px;
}

.payment-section {
    background: white;
    border-radius: 12px;
    padding: 25px;
    margin-bottom: 25px;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
}

.payment-section h3 {
    color: #1f2937;
    margin-bottom: 20px;
    font-size: 1.2rem;
    border-bottom: 2px solid #e5e7eb;
    padding-bottom: 10px;
}

.form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-bottom: 20px;
}

.form-group {
    margin-bottom: 15px;
}

.form-label {
    display: block;
    margin-bottom: 8px;
    font-weight: 600;
    color: #374151;
}

.form-control {
    width: 100%;
    padding: 12px;
    border: 2px solid #e5e7eb;
    border-radius: 6px;
    font-size: 1rem;
    transition: border-color 0.3s;
}

.form-control:focus {
    outline: none;
    border-color: #007bff;
    box-shadow: 0 0 0 3px rgba(0, 123, 255, 0.1);
}

.form-check-input {
    width: auto;
    margin-right: 8px;
}

.error-message {
    background: #f8d7da;
    border: 1px solid #f5c6cb;
    color: #721c24;
    padding: 10px;
    border-radius: 4px;
    margin-top: 5px;
    font-size: 0.9rem;
}

.amount-display {
    background: linear-gradient(135deg, #f8f9fa, #e9ecef);
    border-radius: 12px;
    padding: 20px;
    text-align: center;
}

.amount-info {
    margin-bottom: 10px;
}

.amount-label {
    font-size: 0.9rem;
    color: #6c757d;
    display: block;
    margin-bottom: 5px;
}

.amount-value {
    font-size: 1.5rem;
    font-weight: bold;
    color: #1f2937;
}

.discount-amount {
    color: #dc3545;
}

.final-amount {
    color: #28a745;
}

.savings-info {
    background: #d4edda;
    border-radius: 8px;
    padding: 15px;
    margin-top: 10px;
}

.savings-label {
    color: #155724;
    font-weight: bold;
}

.savings-value {
    color: #155724;
    font-weight: bold;
    font-size: 1.1rem;
}

.form-actions {
    display: flex;
    gap: 15px;
    justify-content: center;
    margin-top: 30px;
}

.btn {
    padding: 15px 30px;
    border: none;
    border-radius: 8px;
    font-size: 1.1rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s;
    text-decoration: none;
}

.btn-primary {
    background: linear-gradient(135deg, #667eea, #764ba2);
    color: white;
    box-shadow: 0 4px 6px rgba(102, 126, 234, 0.1);
}

.btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 12px rgba(102, 126, 234, 0.2);
}

.btn-secondary {
    background: #6c757d;
    color: white;
}

.btn-secondary:hover {
    background: #5a6268;
}

.btn-large {
    padding: 18px 40px;
    font-size: 1.2rem;
}

.alert {
    padding: 15px;
    border-radius: 8px;
    margin-bottom: 20px;
}

.alert-warning {
    background: #fff3cd;
    border: 1px solid #ffeaa7;
    color: #856404;
}

.alert-danger {
    background: #f8d7da;
    border: 1px solid #f5c6cb;
    color: #721c24;
}

.alert-success {
    background: #d4edda;
    border: 1px solid #c3e6cb;
    color: #155724;
}

.general-error, .success-message {
    margin-bottom: 20px;
    text-align: center;
}

.success-message h4 {
    margin-bottom: 10px;
    font-size: 1.2rem;
}

.success-message p {
    margin: 5px 0;
    font-size: 1rem;
}

@media (max-width: 768px) {
    .payment-page {
        padding: 10px;
    }
    
    .form-row {
        grid-template-columns: 1fr;
        gap: 15px;
    }
    
    .form-actions {
        flex-direction: column;
        align-items: stretch;
    }
    
    .btn {
        width: 100%;
        margin-bottom: 10px;
    }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const cardNumberInput = document.getElementById('cardNumber');
    const expiryDateInput = document.getElementById('expiryDate');
    const cvvInput = document.getElementById('cvv');
    const cardHolderInput = document.getElementById('cardHolder');
    const submitBtn = document.getElementById('submitBtn');
    const termsCheckbox = document.getElementById('terms');
    const paymentForm = document.querySelector('.payment-form');
    
    // Messages d'erreur
    const errorMessages = {
        cardNumber: document.querySelector('.card-number-error'),
        expiryDate: document.querySelector('.expiry-date-error'),
        cvv: document.querySelector('.cvv-error'),
        cardHolder: document.querySelector('.card-holder-error')
    };

    function validateCardNumber() {
        const value = cardNumberInput.value.replace(/\D/g, '');
        const isValid = value.length >= 13 && value.length <= 19;
        
        errorMessages.cardNumber.textContent = isValid ? '' : 'Numéro de carte invalide (13-19 chiffres)';
        errorMessages.cardNumber.style.display = isValid ? 'none' : 'block';
        
        return isValid;
    }

    function validateExpiryDate() {
        const value = expiryDateInput.value.replace(/\D/g, '');
        let formattedValue = value;
        
        if (value.length >= 2) {
            formattedValue = value.substring(0, 2) + '/' + value.substring(2, 4);
            expiryDateInput.value = formattedValue;
        }
        
        const regex = /^(0[1-9]|1[0-2])\/([0-9]{2})$/;
        const isValid = regex.test(formattedValue);
        
        if (isValid) {
            const parts = formattedValue.split('/');
            const month = parseInt(parts[0]);
            const year = 2000 + parseInt(parts[1]);
            const expiryDate = new Date(year, month - 1, 1);
            const currentDate = new Date();
            
            const isExpired = expiryDate <= currentDate;
            errorMessages.expiryDate.textContent = isExpired ? 'Carte expirée' : '';
            errorMessages.expiryDate.style.display = isExpired ? 'block' : 'none';
            
            return !isExpired;
        } else {
            errorMessages.expiryDate.textContent = 'Format MM/AA requis';
            errorMessages.expiryDate.style.display = 'block';
            return false;
        }
    }

    function validateCVV() {
        const value = cvvInput.value.replace(/\D/g, '');
        cvvInput.value = value; // Nettoyer le champ
        
        const isValid = value.length >= 3 && value.length <= 4;
        
        errorMessages.cvv.textContent = isValid ? '' : 'CVC invalide (3-4 chiffres)';
        errorMessages.cvv.style.display = isValid ? 'none' : 'block';
        
        return isValid;
    }

    function validateCardHolder() {
        const value = cardHolderInput.value.trim();
        const regex = /^[a-zA-Z\s\-]+$/;
        const isValid = value.length >= 3 && regex.test(value);
        
        errorMessages.cardHolder.textContent = isValid ? '' : 'Nom invalide (3+ caractères, lettres/espaces/tirets)';
        errorMessages.cardHolder.style.display = isValid ? 'none' : 'block';
        
        return isValid;
    }

    function validateAll() {
        const isCardValid = validateCardNumber();
        const isExpiryValid = validateExpiryDate();
        const isCVVValid = validateCVV();
        const isHolderValid = validateCardHolder();
        const areTermsAccepted = termsCheckbox.checked;
        
        const isFormValid = isCardValid && isExpiryValid && isCVVValid && isHolderValid && areTermsAccepted;
        
        submitBtn.disabled = !isFormValid;
        
        return isFormValid;
    }

    // Écouteurs d'événements
    cardNumberInput.addEventListener('input', function() {
        this.value = this.value.replace(/\D/g, '');
        validateAll();
    });
    
    expiryDateInput.addEventListener('input', validateExpiryDate);
    expiryDateInput.addEventListener('blur', validateAll);
    
    cvvInput.addEventListener('input', validateCVV);
    cvvInput.addEventListener('blur', validateAll);
    
    cardHolderInput.addEventListener('input', validateCardHolder);
    cardHolderInput.addEventListener('blur', validateAll);
    
    termsCheckbox.addEventListener('change', validateAll);

    // Soumission du formulaire
    paymentForm.addEventListener('submit', function(e) {
        e.preventDefault();
        
        if (!validateAll()) {
            const generalError = document.createElement('div');
            generalError.className = 'general-error alert alert-danger';
            generalError.textContent = 'Veuillez corriger les erreurs dans le formulaire';
            
            const existingError = document.querySelector('.general-error');
            if (existingError) existingError.remove();
            
            paymentForm.insertBefore(generalError, paymentForm.firstChild);
            return;
        }
        
        submitBtn.disabled = true;
        submitBtn.textContent = 'Traitement en cours...';
        
        const formData = new FormData(paymentForm);
        
        fetch('{{ path("payment_process") }}', {
            method: 'POST',
            body: formData,
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                paymentForm.innerHTML = `
                    <div class="success-message alert alert-success">
                        <h4>✅ Paiement réussi !</h4>
                        <p>${data.message}</p>
                        <p>Commande: ${data.orderId}</p>
                        <p>Montant: ${data.amount} €</p>
                        <p>Redirection vers la boutique...</p>
                    </div>
                `;
                
                setTimeout(() => {
                    window.location.href = '/shop/merch';
                }, 3000);
            } else {
                const errorMessage = document.createElement('div');
                errorMessage.className = 'general-error alert alert-danger';
                errorMessage.textContent = data.message || 'Une erreur est survenue lors du paiement';
                
                const existingError = document.querySelector('.general-error');
                if (existingError) existingError.remove();
                
                paymentForm.insertBefore(errorMessage, paymentForm.firstChild);
                
                submitBtn.disabled = false;
                submitBtn.textContent = '🔒 Payer {{ cartCalculation.total_final ?? 0 }} €';
            }
        })
        .catch(error => {
            console.error('Erreur:', error);
            
            const errorMessage = document.createElement('div');
            errorMessage.className = 'general-error alert alert-danger';
            errorMessage.textContent = 'Une erreur technique est survenue. Veuillez réessayer.';
            
            const existingError = document.querySelector('.general-error');
            if (existingError) existingError.remove();
            
            paymentForm.insertBefore(errorMessage, paymentForm.firstChild);
            
            submitBtn.disabled = false;
            submitBtn.textContent = '🔒 Payer {{ cartCalculation.total_final ?? 0 }} €';
        });
    });

    // Validation initiale
    validateAll();
});
</script>
{% endblock %}
