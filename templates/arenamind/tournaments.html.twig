{% extends 'front/base_front.html.twig' %}
{% block title %}ArenaMind • Tournaments{% endblock %}

{% block body %}
<style>
  .am-section-title{display:flex;align-items:baseline;justify-content:space-between;gap:12px;margin-bottom:18px}
  .am-section-title h1{margin:0;text-align:left;color:#fff}
  .am-section-title p{margin:8px 0 0;color:var(--muted);font-size:13px}

  .am-top-actions{display:flex;gap:10px;flex-wrap:wrap}
  .am-btn{display:inline-flex;align-items:center;gap:10px;padding:10px 14px;border-radius:14px;text-decoration:none;font-weight:900;border:1px solid rgba(49,46,129,.55);background:rgba(5,8,20,.45);color:#fff}
  .am-btn--primary{border:none;background:linear-gradient(90deg,var(--purple),var(--blue));}

  .am-wrap{display:grid;grid-template-columns:1fr 1fr;gap:16px}
  .am-t-card{
    background:rgba(11,15,46,.45);
    border:1px solid rgba(49,46,129,.55);
    border-radius:18px;
    padding:18px;
  }
  .am-pill{display:inline-flex;padding:7px 12px;border-radius:999px;border:1px solid rgba(49,46,129,.55);background:rgba(5,8,20,.45);font-weight:900;font-size:12px}
  .am-name{margin:12px 0 8px;font-size:22px;font-weight:900}
  .am-sub{color:var(--muted);font-size:13px;margin:0 0 14px}
  .am-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-top:8px}
  .am-metric{background:rgba(5,8,20,.35);border:1px solid rgba(49,46,129,.45);border-radius:16px;padding:12px}
  .am-metric b{display:block;font-size:12px;color:#cbd5f5;margin-bottom:6px}
  .am-metric span{font-weight:900}
  .am-row{display:flex;gap:12px;flex-wrap:wrap;margin-top:14px}

  @media (max-width: 980px){.am-wrap{grid-template-columns:1fr}.am-grid{grid-template-columns:1fr 1fr}}
</style>

<div class="am-section-title">
  <div>
    <h1>🏆 Upcoming Tournaments</h1>
    <p>Structure réaliste : check-in, rules, slots, prize.</p>
  </div>

  <div class="am-top-actions">
    <a class="am-btn" href="{{ path('am_dashboard') }}">⬅️ Back</a>
    {# Bouton demandé vers la page CRUD (Tournament) #}
    <a class="am-btn am-btn--primary" href="{{ path('am_tournament_index') }}">⚙️ Manage tournaments (CRUD)</a>
  </div>
</div>

<div class="am-wrap">
  {% if tournaments is empty %}
    {# Démo proche de la maquette #}
    <div class="am-t-card">
      <span class="am-pill">Valorant</span>
      <div class="am-name">ArenaMind Cup — Valorant</div>
      <p class="am-sub">Saturday • 5v5 • Prize: 500DT • BO1 → BO3 playoffs</p>
      <div class="am-grid">
        <div class="am-metric"><b>Check-in</b><span>18:00</span></div>
        <div class="am-metric"><b>Start</b><span>19:00</span></div>
        <div class="am-metric"><b>Slots</b><span>16 teams</span></div>
        <div class="am-metric"><b>Rules</b><span>Standard</span></div>
      </div>
      <div class="am-row">
        <a class="am-btn am-btn--primary" href="#">Request invitation</a>
        <a class="am-btn" href="{{ path('am_tournament_index') }}">Browse cups</a>
      </div>
    </div>

    <div class="am-t-card">
      <span class="am-pill">LoL</span>
      <div class="am-name">LoL Weekly Clash</div>
      <p class="am-sub">Friday • Team format • Prize: points + badges</p>
      <div class="am-grid">
        <div class="am-metric"><b>Check-in</b><span>17:30</span></div>
        <div class="am-metric"><b>Start</b><span>18:30</span></div>
        <div class="am-metric"><b>Slots</b><span>8 teams</span></div>
        <div class="am-metric"><b>Rules</b><span>Clash</span></div>
      </div>
      <div class="am-row">
        <a class="am-btn am-btn--primary" href="#">Ask for slot</a>
        <a class="am-btn" href="{{ path('am_tournament_index') }}">Browse events</a>
      </div>
    </div>
  {% else %}
    {% for t in tournaments %}
      <div class="am-t-card">
        <span class="am-pill">{{ t.game ? t.game.name : 'Game' }}</span>
        <div class="am-name">{{ t.name }}</div>
        <p class="am-sub">
          {{ t.startAt|date('l d/m/Y') }} • {{ t.format }} • Prize: {{ t.prize }} • Status: {{ t.status }}
        </p>
        <div class="am-grid">
          <div class="am-metric"><b>Check-in</b><span>{{ t.checkInAt ? t.checkInAt|date('H:i') : '—' }}</span></div>
          <div class="am-metric"><b>Start</b><span>{{ t.startAt|date('H:i') }}</span></div>
          <div class="am-metric"><b>Slots</b><span>{{ t.slots }}</span></div>
          <div class="am-metric"><b>Rules</b><span>{{ t.rules }}</span></div>
        </div>
        <div class="am-row">
          <a class="am-btn" href="{{ path('am_tournament_show', {'id': t.id}) }}">Details</a>
          <a class="am-btn" href="{{ path('am_tournament_edit', {'id': t.id}) }}">Edit</a>
        </div>
      </div>
    {% endfor %}
  {% endif %}
</div>
{% endblock %}
