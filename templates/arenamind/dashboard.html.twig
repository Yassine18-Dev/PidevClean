{% extends 'front/base_front.html.twig' %}
{% block title %}ArenaMind • Season{% endblock %}

{% block body %}
<style>
  /* Dashboard hero (proche des maquettes) */
  .am-hero{
    display:grid;
    grid-template-columns: 1.2fr .8fr;
    gap:22px;
    align-items:stretch;
    background:rgba(11,15,46,.45);
    border:1px solid rgba(49,46,129,.55);
    border-radius:18px;
    padding:24px;
    box-shadow:0 0 40px rgba(168,85,247,.18);
  }
  .am-chip{
    display:inline-flex; align-items:center; gap:8px;
    padding:8px 12px;
    border-radius:999px;
    border:1px solid rgba(49,46,129,.55);
    background:rgba(5,8,20,.45);
    color:#fff;
    font-size:13px;
    font-weight:800;
    width:fit-content;
  }
  .am-headline{
    margin:18px 0 10px;
    font-size:46px;
    line-height:1.05;
    font-weight:900;
    letter-spacing:.2px;
    color:var(--purple);
  }
  .am-desc{color:var(--muted);margin:0 0 18px;font-size:14px;line-height:1.6}

  .am-btn-row{display:flex;gap:12px;flex-wrap:wrap;margin-top:10px}
  .am-btn{
    display:inline-flex; align-items:center; gap:10px;
    padding:12px 16px;
    border-radius:14px;
    text-decoration:none;
    font-weight:900;
    border:1px solid rgba(49,46,129,.55);
    background:rgba(5,8,20,.45);
    color:#fff;
  }
  .am-btn:hover{opacity:.95;transform:translateY(-1px)}
  .am-btn--primary{border:none;background:linear-gradient(90deg,var(--purple),var(--blue));}

  .am-hero-media{
    border-radius:16px;
    border:1px solid rgba(49,46,129,.55);
    background:
      radial-gradient(600px 260px at 70% 20%, rgba(59,130,246,.35), transparent 60%),
      radial-gradient(600px 260px at 30% 80%, rgba(168,85,247,.35), transparent 60%),
      linear-gradient(180deg, rgba(0,0,0,.25), rgba(0,0,0,.45));
    position:relative;
    overflow:hidden;
    min-height:260px;
  }
  .am-badge{
    position:absolute;left:14px;bottom:14px;
    background:rgba(5,8,20,.75);
    border:1px solid rgba(49,46,129,.55);
    border-radius:14px;
    padding:12px 14px;
    width:calc(100% - 28px);
  }
  .am-badge-title{display:flex;align-items:center;gap:10px;font-weight:900}
  .am-badge-sub{margin-top:6px;color:var(--muted);font-size:13px;display:flex;justify-content:space-between;gap:10px}

  .am-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-top:16px}
  .am-stat{
    background:rgba(5,8,20,.35);
    border:1px solid rgba(49,46,129,.45);
    border-radius:16px;
    padding:14px;
  }
  .am-stat b{display:block;font-size:22px;color:var(--purple)}
  .am-stat span{color:var(--muted);font-size:13px}

  @media (max-width: 860px){
    .am-hero{grid-template-columns:1fr}
    .am-headline{font-size:38px}
    .am-stats{grid-template-columns:repeat(2,1fr)}
  }
</style>

<div class="am-hero">
  <div>
    <div class="am-chip">⚡ ArenaMind • Season 2026</div>
    <div class="am-headline">Play. Compete. Win.</div>
    <p class="am-desc">
      ArenaMind est votre plateforme e-sport : équipes, tournois, rankings, shop, et support.
      Construisez votre profil et rejoignez des événements compétitifs chaque semaine.
    </p>

    <div class="am-btn-row">
      <a class="am-btn am-btn--primary" href="{{ path('am_tournaments') }}">🏆 Join tournaments</a>
      <a class="am-btn" href="{{ path('am_games') }}">🎮 Explore games</a>
      <a class="am-btn" href="/shop/merch">🛒 Shop</a>
    </div>

    <div class="am-btn-row" style="margin-top:14px">
      <a class="am-btn" href="{{ path('ui_profile') }}">👤 Profile</a>
      <a class="am-btn" href="{{ path('ui_profile_edit') }}">✏️ Edit profile</a>
      <a class="am-btn" href="{{ path('ui_logout') }}">🚪 Logout</a>
    </div>

    <div class="am-stats">
      <div class="am-stat"><b>120+</b><span>Players</span></div>
      <div class="am-stat"><b>18</b><span>Weekly events</span></div>
      <div class="am-stat"><b>3</b><span>Main games</span></div>
      <div class="am-stat"><b>500DT</b><span>Prize pools</span></div>
    </div>
  </div>

  <div class="am-hero-media">
    <div class="am-badge">
      <div class="am-badge-title">🔥 Featured</div>
      <div class="am-badge-sub">
        <span>ArenaMind Cup — Valorant (Saturday)</span>
        <a class="am-btn" style="padding:8px 12px" href="{{ path('am_tournaments') }}">View details</a>
      </div>
    </div>
  </div>
</div>
{% endblock %}
