{% extends 'front/base_front.html.twig' %}

{% block title %}Team Invitations{% endblock %}

{% block body %}
<div class="am-container" style="max-width:1100px; margin:24px auto;">
  <div class="am-card">
    <div class="am-card__head" style="display:flex; justify-content:space-between; align-items:center;">
      <div style="font-weight:900;">📨 MANAGE INVITATIONS — {{ team.name }}</div>
      <div style="display:flex; gap:8px;">
        <a class="am-btn" href="{{ path('team_show', {id: team.id}) }}">← Back</a>
      </div>
    </div>

    <div class="am-card__body">
      <div style="display:flex; gap:10px; margin-bottom:12px;">
        <a class="am-tab {{ tab == 'pending' ? 'is-active' : '' }}" href="{{ path('team_invitations', {id: team.id, tab:'pending'}) }}">Pending ({{ pendingInvitations|length }})</a>
        <a class="am-tab {{ tab == 'history' ? 'is-active' : '' }}" href="{{ path('team_invitations', {id: team.id, tab:'history'}) }}">History</a>
      </div>

      {% if tab == 'history' %}
        {% if historyInvitations is empty %}
          <div style="opacity:.85;">No history.</div>
        {% else %}
          <div style="display:flex; flex-direction:column; gap:10px;">
            {% for inv in historyInvitations %}
              <div class="am-invite-card">
                <div style="display:flex; justify-content:space-between; flex-wrap:wrap; gap:10px;">
                  <div>
                    <div style="font-weight:900;">👤 {{ inv.player.nickname }}</div>
                    <div style="opacity:.85; font-size:13px;">Status: {{ inv.status }} • {{ inv.createdAt|date('d/m/Y H:i') }}</div>
                  </div>
                </div>
              </div>
            {% endfor %}
          </div>
        {% endif %}
      {% else %}
        <div style="margin-bottom:18px;">
          <div style="font-weight:900; margin-bottom:8px;">INVITATIONS EN ATTENTE ({{ pendingInvitations|length }})</div>
          {% if pendingInvitations is empty %}
            <div style="opacity:.85;">No pending invitations.</div>
          {% else %}
            <div style="display:flex; flex-direction:column; gap:10px;">
              {% for inv in pendingInvitations %}
                <div class="am-invite-card">
                  <div style="display:flex; justify-content:space-between; flex-wrap:wrap; gap:10px;">
                    <div>
                      <div style="font-weight:900;">👤 {{ inv.player.nickname }}</div>
                      <div style="opacity:.85; font-size:13px;">Invited at {{ inv.createdAt|date('d/m/Y') }}</div>
                    </div>
                    <div style="display:flex; gap:8px;">
                      {# optional: cancel route if you add it later #}
                      <span class="am-badge">PENDING</span>
                    </div>
                  </div>
                </div>
              {% endfor %}
            </div>
          {% endif %}
        </div>

        <div style="border-top:1px solid rgba(255,255,255,.08); padding-top:16px;">
          <div style="font-weight:900; margin-bottom:8px;">👥 INVITER UN NOUVEAU JOUEUR</div>

          <form method="get" action="{{ path('team_invitations', {id: team.id}) }}" style="display:flex; gap:10px; margin-bottom:12px;">
            <input type="hidden" name="tab" value="pending">
            <input class="am-input" type="text" name="q" value="{{ q }}" placeholder="Search players (nickname/name)..." style="flex:1;">
            <button class="am-btn am-btn--primary" type="submit">🔍 Search</button>
          </form>

          {% if availablePlayers is empty %}
            <div style="opacity:.85;">No available players.</div>
          {% else %}
            <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(260px, 1fr)); gap:10px;">
              {% for p in availablePlayers %}
                <div class="am-invite-card">
                  <div style="font-weight:900;">👤 {{ p.nickname }}</div>
                  <div style="opacity:.85; font-size:13px; margin-top:4px;">Sans équipe</div>
                  <form method="post" action="{{ path('team_send_invite', {id: team.id, playerId: p.id}) }}" style="margin-top:10px;">
                    <button class="am-btn am-btn--success" type="submit">Send invite</button>
                  </form>
                </div>
              {% endfor %}
            </div>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
</div>

<style>
  .am-tab{
    display:inline-block;
    padding:8px 12px;
    border-radius:10px;
    background: rgba(255,255,255,.04);
    border:1px solid rgba(255,255,255,.08);
    text-decoration:none;
    color:inherit;
    font-weight:800;
  }
  .am-tab.is-active{
    border-color: rgba(0,168,255,.55);
    box-shadow: 0 0 16px rgba(0,168,255,.14);
  }
  .am-invite-card{
    background: rgba(255,255,255,.04);
    border: 1px solid rgba(255,255,255,.08);
    border-radius: 12px;
    padding: 12px;
    transition: transform .15s ease, box-shadow .15s ease;
  }
  .am-invite-card:hover{
    transform: scale(1.01);
    box-shadow: 0 0 18px rgba(0,168,255,.14);
  }
  .am-badge{
    padding:6px 10px;
    border-radius:999px;
    background: rgba(255,184,0,.12);
    border:1px solid rgba(255,184,0,.35);
    font-weight:900;
    font-size:12px;
  }
  .am-input{
    padding:10px 12px;
    border-radius:12px;
    border:1px solid rgba(255,255,255,.12);
    background: rgba(0,0,0,.25);
    color: #fff;
    outline: none;
  }
</style>
{% endblock %}