{% extends 'front/base_front.html.twig' %}
{% block title %}ArenaMind • Invitations • {{ team.name }}{% endblock %}

{% block body %}
<style>
  .wrap{max-width:1100px;margin:0 auto;}
  .card{background:rgba(11,15,46,.55); border:1px solid rgba(49,46,129,.55); border-radius:16px; padding:14px;}
  .muted{color:var(--muted);}
  .btn{display:inline-flex; align-items:center; justify-content:center; padding:10px 14px; border-radius:14px; text-decoration:none; font-weight:900; font-size:13px; border:1px solid rgba(49,46,129,.55); background:rgba(5,8,20,.45); color:#fff;}
  .btn:hover{opacity:.95}
  .btnPrimary{border:none; background:linear-gradient(90deg,var(--purple),var(--blue));}
  .btnDanger{border:none; background:linear-gradient(90deg,#ef4444,#b91c1c);}
  .input{padding:12px;border-radius:14px;border:1px solid rgba(49,46,129,.55);background:#0b0f2e;color:#fff;outline:none;}
  .tabs{display:flex; gap:10px; flex-wrap:wrap; margin:12px 0;}
  .tab{padding:8px 12px;border-radius:999px;border:1px solid rgba(49,46,129,.55);background:rgba(5,8,20,.45);font-weight:1000;font-size:12px;}
  .tab.active{border:none;background:linear-gradient(90deg,var(--purple),var(--blue));}
</style>

<div class="wrap">
  <div style="display:flex; justify-content:space-between; align-items:center; gap:10px; flex-wrap:wrap; margin-bottom:14px;">
    <div>
      <div style="font-weight:1000; font-size:20px;">📨 Gérer les invitations</div>
      <div class="muted" style="font-size:13px;">{{ team.name }} • {{ team.game|upper }} • 👥 {{ team.players|length }}/{{ team.maxPlayers }}</div>
    </div>
    <div style="display:flex; gap:10px; flex-wrap:wrap;">
      <a class="btn" href="{{ path('app_team_show', {id: team.id}) }}">← Voir l’équipe</a>
      <a class="btn" href="{{ path('ui_profile') }}">← Profil</a>
    </div>
  </div>

  <div class="tabs">
    <span class="tab active">Invitations en attente ({{ pending|length }})</span>
    <span class="tab">Historique (v2+)</span>
  </div>

  <div class="card">
    <h3 style="margin:0 0 10px;">Invitations en attente</h3>

    {% if pending|length == 0 %}
      <div class="muted">Aucune invitation en attente.</div>
    {% else %}
      <div style="display:grid; gap:10px;">
        {% for inv in pending %}
          {% set p = inv.player %}
          <div style="padding:12px; border-radius:14px; border:1px solid rgba(49,46,129,.45); background:rgba(5,8,20,.35);">
            <div style="display:flex; align-items:center; justify-content:space-between; gap:12px; flex-wrap:wrap;">
              <div>
                <div style="font-weight:1000;">👤 {{ p.nickname }} • {{ p.rank ?? '—' }}</div>
                <div class="muted" style="font-size:12px; margin-top:4px;">
                  🎮 {{ p.game|upper }} • Sans équipe • Invité le {{ inv.createdAt|date('d/m/Y') }}
                  • Expire le {{ inv.expiresAt ? inv.expiresAt|date('d/m/Y') : '—' }}
                </div>
              </div>
              <form method="post" action="{{ path('team_invitation_cancel', {teamId: team.id, id: inv.id}) }}">
                <button class="btn btnDanger" type="submit">Annuler l’invitation</button>
              </form>
            </div>
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>

  <div class="card" style="margin-top:14px;">
    <h3 style="margin:0 0 10px;">👥 Inviter un nouveau joueur</h3>

    <form method="get" action="{{ path('team_invitations', {id: team.id}) }}" style="display:flex; gap:10px; flex-wrap:wrap; align-items:center;">
      <input class="input" type="text" name="q" value="{{ search }}" placeholder="Rechercher par pseudo (joueurs disponibles uniquement)" style="flex:1; min-width:260px;">
      <button class="btn btnPrimary" type="submit">🔍 Rechercher</button>
    </form>

    <div class="muted" style="font-size:13px; margin-top:8px;">
      Règles : joueurs sans équipe (LoL/Valorant), non déjà invités, max 5 invitations / 24h / équipe, max joueurs = {{ team.maxPlayers }}.
    </div>

    <div style="display:grid; gap:10px; margin-top:12px;">
      {% if results|length == 0 %}
        <div class="muted">Aucun joueur disponible pour cette recherche.</div>
      {% else %}
        {% for p in results %}
          <div style="padding:12px; border-radius:14px; border:1px solid rgba(49,46,129,.45); background:rgba(5,8,20,.35); display:flex; align-items:center; justify-content:space-between; gap:12px; flex-wrap:wrap;">
            <div>
              <div style="font-weight:1000;">👤 {{ p.nickname }} • {{ p.rank ?? '—' }}</div>
              <div class="muted" style="font-size:12px; margin-top:4px;">🎮 {{ p.game|upper }} • Sans équipe</div>
            </div>
            <form method="post" action="{{ path('team_invitations', {id: team.id}) }}">
              <input type="hidden" name="player_id" value="{{ p.id }}">
              <button class="btn btnPrimary" type="submit">Envoyer une invitation</button>
            </form>
          </div>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</div>
{% endblock %}
