{% extends 'front/base_front.html.twig' %}

{% block title %}Teams{% endblock %}

{% block body %}
<div class="am-container" style="max-width:1100px; margin:24px auto;">
  <div class="am-card">
    <div class="am-card__head" style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px;">
      <div style="font-weight:900; font-size:20px;">🛡️ Teams</div>
      <div style="display:flex; gap:10px;">
        <a href="#" class="btn-outline-secondary" style="display:inline-flex; align-items:center; gap:8px; padding:8px 16px; border-radius:8px; border:1px solid rgba(255,255,255,0.2); background:rgba(255,255,255,0.1); color:#fff; text-decoration:none;">
            <i class="fas fa-plus"></i> Nouvelle équipe
        </a>
        <div class="mb-3" style="margin-bottom:0 !important;">
            <a href="{{ path('profile_index') }}" class="btn btn-outline-secondary" style="display:inline-flex; align-items:center; gap:8px; padding:8px 16px; border-radius:8px; border:1px solid rgba(255,255,255,0.2); color:#fff; text-decoration:none;">
                <i class="fas fa-arrow-left"></i> Retour au profil
            </a>
        </div>
      </div>
    </div>

    <div class="am-card__body">
      {% if teams is empty %}
        <div style="opacity:.85;">No teams.</div>
      {% else %}
        <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(300px, 1fr)); gap:10px;">
          {% for t in teams %}
            <div class="am-tcard" style="padding:0; overflow:hidden; display:flex; flex-direction:column; border-radius:12px; background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08);">
              <div style="height:120px; background:#1e1e2f; position:relative;">
                {% if t.bannerName %}
                  <img src="{{ asset('uploads/teams/banners/' ~ t.bannerName) }}" style="width:100%; height:100%; object-fit:cover; opacity:0.7;">
                {% else %}
                  <div style="width:100%; height:100%; background:linear-gradient(135deg, rgba(0,168,255,.16), rgba(145,71,255,.10));"></div>
                {% endif %}
                
                <div style="position:absolute; bottom:-30px; left:20px; width:64px; height:64px; border-radius:16px; background:#2a2a3c; border:3px solid #1a1a2e; overflow:hidden; display:flex; align-items:center; justify-content:center; font-size:30px; box-shadow:0 4px 10px rgba(0,0,0,0.5);">
                  {% if t.logoName %}
                    <img src="{{ asset('images/team-logos/' ~ t.logoName) }}" style="width:100%; height:100%; object-fit:cover;">
                  {% else %}
                    🛡️
                  {% endif %}
                </div>
              </div>
              
              <div style="padding:40px 20px 20px 20px; flex:1; display:flex; flex-direction:column;">
                <div style="font-weight:1000; font-size:20px;">{{ t.name }}</div>
                
                <div style="display:flex; justify-content:space-between; margin-top:16px; font-size:14px; opacity:0.8; background:rgba(0,0,0,0.2); padding:10px; border-radius:8px;">
                  <span style="display:flex; align-items:center; gap:6px;">
                    <i class="fas fa-users"></i> {{ t.players|length }}/{{ t.maxPlayers }}
                  </span>
                  {% if t.players|length >= t.maxPlayers %}
                    <span style="color: var(--am-danger); font-weight: 800; font-size: 11px; text-transform: uppercase;">FULL</span>
                  {% else %}
                    <span style="color: var(--am-success); font-weight: 800; font-size: 11px; text-transform: uppercase;">Recrutement ouvert</span>
                  {% endif %}
                </div>
                
                <div style="margin-top:20px; display:flex; flex-direction:column; gap:10px;">
                  <a href="{{ path('team_show', {id: t.id}) }}" style="text-align:center; padding:10px; border-radius:8px; background:rgba(255,255,255,0.05); color:#fff; text-decoration:none; font-weight:bold; border:1px solid rgba(255,255,255,0.1); transition:all 0.2s;">
                    Voir profil équipe
                  </a>

                  {% if app.user and app.user.player %}
                      {% set player = app.user.player %}
                      {% if not player.team and t.players|length < t.maxPlayers %}
                          <form action="{{ path('team_apply', {id: t.id}) }}" method="POST" style="margin:0;">
                              <button type="submit" style="width:100%; padding:10px; border-radius:8px; background:var(--am-primary); color:#fff; border:none; font-weight:bold; cursor:pointer; transition:all 0.2s;">
                                  🚀 Postuler
                              </button>
                          </form>
                      {% endif %}
                  {% endif %}
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
</div>

<style>
  .am-tcard{
    display:block;
    text-decoration:none;
    color:inherit;
    background: rgba(255,255,255,.04);
    border: 1px solid rgba(255,255,255,.08);
    border-radius: 12px;
    padding: 12px;
    transition: transform .15s ease, box-shadow .15s ease;
  }
  .am-tcard:hover{
    transform: scale(1.01);
    box-shadow: 0 0 18px rgba(0,168,255,.14);
  }
</style>
{% endblock %}