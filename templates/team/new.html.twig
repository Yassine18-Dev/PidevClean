{% extends 'front/base_front.html.twig' %}
{% block title %}ArenaMind • New Team{% endblock %}

{% block body %}
<style>
  .wrap{max-width:1100px;margin:0 auto;}
  .topbar{display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:14px;}
  .btn{display:inline-flex;align-items:center;gap:8px;padding:10px 14px;border-radius:14px;border:1px solid rgba(49,46,129,.55);background:rgba(5,8,20,.45);color:#fff;text-decoration:none;font-weight:900;font-size:13px;}
  .btn:hover{opacity:.95}
  .btnPrimary{border:none;background:linear-gradient(90deg,var(--purple),var(--blue));}
  .btnGhost{border:1px solid rgba(49,46,129,.55);background:rgba(5,8,20,.45);}
  .card{background:rgba(11,15,46,.55);border:1px solid rgba(49,46,129,.55);border-radius:18px;padding:16px;box-shadow:0 0 40px rgba(168,85,247,.10);}
  .muted{color:var(--muted);}
  .grid{display:grid;grid-template-columns: 1fr 360px; gap:14px;}
  .field{display:flex;flex-direction:column;gap:8px;margin-bottom:12px;}
  .label{font-weight:1000;font-size:13px;}
  .input,.select,.textarea{
    padding:12px;border-radius:14px;border:1px solid rgba(49,46,129,.55);
    background:#0b0f2e;color:#fff;outline:none;
  }
  .help{font-size:12px;color:var(--muted);line-height:1.4;}
  .logoGrid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:10px;margin-top:10px;}
  .logoChoice{
    cursor:pointer;border-radius:16px; padding:10px;
    border:1px solid rgba(49,46,129,.55);
    background:rgba(5,8,20,.45);
    display:flex;align-items:center;justify-content:center;
    transition:transform .08s ease, border-color .08s ease;
  }
  .logoChoice:hover{transform:translateY(-1px);}
  .logoChoice.active{border:none;background:linear-gradient(90deg,var(--purple),var(--blue));}
  .logoChoice img{width:56px;height:56px;border-radius:14px;object-fit:cover;border:1px solid rgba(255,255,255,.10);background:rgba(0,0,0,.2);}
  .pill{display:inline-flex;align-items:center;gap:6px;padding:6px 10px;border-radius:999px;border:1px solid rgba(49,46,129,.55);background:rgba(5,8,20,.45);font-weight:900;font-size:12px;}
  .actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:12px;}
  @media(max-width:980px){.grid{grid-template-columns:1fr;}}
</style>

<div class="wrap">
  <div class="topbar">
    <a class="btn" href="{{ path('ui_profile') }}"><i class="fa-solid fa-arrow-left"></i> Retour au profil</a>
    <div style="text-align:center;flex:1;min-width:240px;">
      <h1 style="margin:0;font-size:20px;">Créer une équipe</h1>
      <div class="muted" style="font-size:13px;margin-top:6px;">ArenaMind • design harmonisé</div>
    </div>
    <a class="btn" href="{{ path('app_team_index') }}"><i class="fa-solid fa-shield-halved"></i> Teams</a>
  </div>

  <div class="grid">
    {# LEFT: FORM #}
    <div class="card">
      <div style="display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:10px;">
        <div style="font-weight:1000;">Infos équipe</div>
        <span class="pill">Max: 5 joueurs</span>
      </div>

      {{ form_start(form) }}

      <div class="field">
        <div class="label">Nom</div>
        {# Champs Symfony existant (TeamType) #}
        {% if form.name is defined %}
          {{ form_widget(form.name, {attr: {class: 'input', placeholder: 'Ex: Team Alpha'}}) }}
          {{ form_errors(form.name) }}
        {% else %}
          <input class="input" name="team[name]" placeholder="Ex: Team Alpha" />
        {% endif %}
        <div class="help">Nom affiché publiquement.</div>
      </div>

      <div class="field">
        <div class="label">Jeu</div>
        {% if form.game is defined %}
          {{ form_widget(form.game, {attr: {class: 'select'}}) }}
          {{ form_errors(form.game) }}
        {% else %}
          <select class="select" name="team[game]">
            <option value="lol">League of Legends</option>
            <option value="valorant">Valorant</option>
          </select>
        {% endif %}
        <div class="help">Les équipes supportent LoL et Valorant.</div>
      </div>

      <div class="field">
        <div class="label">Max joueurs</div>
        {% if form.maxPlayers is defined %}
          {{ form_widget(form.maxPlayers, {attr: {class: 'input', min: 2, max: 5}}) }}
          {{ form_errors(form.maxPlayers) }}
        {% else %}
          <input class="input" type="number" name="team[maxPlayers]" value="5" min="2" max="5" />
        {% endif %}
        <div class="help">Par défaut 5 (LoL/Valorant).</div>
      </div>

      {# Logo field hidden (filled by grid). Works if TeamType has logoName. #}
      <div style="display:none;">
        {% if form.logoName is defined %}
          {{ form_widget(form.logoName, {attr: {id: 'team_logoName'}}) }}
        {% else %}
          <input type="hidden" id="team_logoName" name="team[logoName]" />
        {% endif %}
      </div>

      {# Render remaining hidden fields (CSRF, etc.) #}
      {{ form_rest(form) }}

      <div class="actions">
        <button class="btn btnPrimary" type="submit"><i class="fa-solid fa-check"></i> Créer</button>
        <a class="btn btnGhost" href="{{ path('app_team_index') }}"><i class="fa-solid fa-xmark"></i> Annuler</a>
      </div>

      {{ form_end(form) }}
    </div>

    {# RIGHT: LOGO PICKER #}
    <div class="card">
      <div style="font-weight:1000;">Choisir un logo</div>
      <div class="muted" style="font-size:13px;margin-top:6px;line-height:1.5;">
        Clique sur un logo (10 choix). Le nom du fichier sera enregistré dans <code>logo_name</code>.
      </div>

      <div class="logoGrid" id="logoGrid">
        {% set logos = [
          'team-logo-1.png','team-logo-2.png','team-logo-3.png','team-logo-4.png','team-logo-5.png',
          'team-logo-6.png','team-logo-7.png','team-logo-8.png','team-logo-9.png','team-logo-10.png'
        ] %}
        {% for logo in logos %}
          <div class="logoChoice" data-logo="{{ logo }}" title="{{ logo }}">
            <img src="{{ asset('images/team-logos/' ~ logo) }}" alt="{{ logo }}">
          </div>
        {% endfor %}
      </div>

      <div class="item" style="margin-top:12px;padding:12px;border-radius:16px;border:1px solid rgba(49,46,129,.45);background:rgba(5,8,20,.45);">
        <div class="muted" style="font-size:12px;">Logo sélectionné :</div>
        <div id="selectedLogoLabel" style="font-weight:1000;margin-top:6px;">Aucun</div>
      </div>
    </div>
  </div>
</div>

<script>
(function(){
  const hidden = document.getElementById('team_logoName');
  const label = document.getElementById('selectedLogoLabel');
  const items = document.querySelectorAll('#logoGrid .logoChoice');

  function setActive(el){
    items.forEach(x => x.classList.remove('active'));
    el.classList.add('active');
  }

  // Default: logo 1 si rien
  const defaultLogo = 'team-logo-1.png';
  if (hidden && !hidden.value) {
    hidden.value = defaultLogo;
    label.textContent = defaultLogo;
    const first = Array.from(items).find(x => x.dataset.logo === defaultLogo);
    if (first) setActive(first);
  }

  items.forEach(el => {
    el.addEventListener('click', () => {
      const val = el.dataset.logo;
      if (hidden) hidden.value = val;
      label.textContent = val;
      setActive(el);
    });
  });
})();
</script>
{% endblock %}