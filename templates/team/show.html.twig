{% extends 'front/base_front.html.twig' %}
{% block title %}Team • {{ team.name }}{% endblock %}

{% block body %}
<style>
  .wrap{max-width:1200px;margin:0 auto;}
  .topbar{display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:14px;}
  .btn{display:inline-flex;align-items:center;gap:8px;padding:10px 14px;border-radius:14px;border:1px solid rgba(49,46,129,.55);background:rgba(5,8,20,.45);color:#fff;text-decoration:none;font-weight:900;font-size:13px;}
  .btn:hover{opacity:.95}
  .btnPrimary{border:none;background:linear-gradient(90deg,var(--purple),var(--blue));}
  .btnDanger{border:none;background:linear-gradient(90deg,#ef4444,#b91c1c);}
  .card{background:rgba(11,15,46,.55);border:1px solid rgba(49,46,129,.55);border-radius:18px;padding:16px;box-shadow:0 0 40px rgba(168,85,247,.10);}
  .muted{color:var(--muted);}
  .teamBanner{width:100%;height:240px;border-radius:20px;overflow:hidden;position:relative;border:1px solid rgba(49,46,129,.35);background:linear-gradient(135deg, rgba(0,168,255,.16), rgba(145,71,255,.10));}
  .teamBanner img{width:100%;height:100%;object-fit:cover;filter:saturate(1.05);}
  .teamBanner:after{content:'';position:absolute;inset:0;background:linear-gradient(180deg, rgba(10,12,16,.15), rgba(10,12,16,.85));}
  .teamHero{display:flex;gap:14px;align-items:center;flex-wrap:wrap;position:relative;z-index:1;}
  .logo{width:92px;height:92px;border-radius:18px;object-fit:cover;border:1px solid rgba(255,255,255,.08)}
  .pill{display:inline-flex;align-items:center;gap:8px;padding:6px 10px;border-radius:999px;border:1px solid rgba(49,46,129,.55);background:rgba(5,8,20,.45);font-weight:900;font-size:12px;margin-right:8px;}
  .tabs{display:flex;gap:10px;flex-wrap:wrap;margin:14px 0;}
  .tabBtn{cursor:pointer;user-select:none}
  .tabBtn.active{border:none;background:linear-gradient(90deg,var(--purple),var(--blue));}
  .grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;}
  .member{display:flex;gap:12px;align-items:center;}
  .avatar{width:56px;height:56px;border-radius:16px;object-fit:cover;border:1px solid rgba(255,255,255,.08)}
  .miniBadge{display:inline-flex;align-items:center;gap:6px;padding:6px 10px;border-radius:999px;border:1px solid rgba(49,46,129,.55);background:rgba(5,8,20,.45);font-size:12px;font-weight:900;}
  @media(max-width: 980px){.grid{grid-template-columns:1fr;}}
</style>

<div class="wrap">
<div class="teamBanner" style="margin-bottom:14px;">
  {% if team.bannerName %}
    <img src="{{ asset('uploads/teams/banners/' ~ team.bannerName) }}" alt="Banner">
  {% else %}
    <img src="{{ asset('images/team-banners/default-banner.jpg') }}" alt="Banner">
  {% endif %}
</div>


  <div class="topbar">
    <a class="btn" href="{{ path('ui_profile') }}"><i class="fa-solid fa-arrow-left"></i> Retour au profil</a>
    <div style="display:flex;gap:10px;flex-wrap:wrap;">
      {% if is_granted('ROLE_USER') %}
        <a class="btn" href="{{ path('team_invitations', {'id': team.id}) }}"><i class="fa-solid fa-user-plus"></i> Invitations</a>
      {% endif %}
      {% if is_granted('ROLE_CAPTAIN') %}
        <a class="btn btnPrimary" href="{{ path('app_team_edit', {'id': team.id}) }}"><i class="fa-solid fa-pen"></i> Modifier</a>
      {% endif %}
    </div>
  </div>

  <div class="card">
    <div class="teamHero">
      {% if team.logoName %}
        <img class="logo" src="{{ asset('images/team-logos/' ~ team.logoName) }}" alt="{{ team.name }}">
      {% else %}
        <div class="logo" style="display:flex;align-items:center;justify-content:center;">🛡️</div>
      {% endif %}

      <div style="flex:1;min-width:240px;">
        <div style="font-size:22px;font-weight:1000;margin-bottom:6px;">{{ team.name }}</div>
        <div style="margin-bottom:8px;">
          <span class="pill">🎮 {{ team.game|upper }}</span>
          <span class="pill">👥 {{ team.players|length }}/{{ team.maxPlayers }}</span>
          {% if team.maxPlayers > team.players|length %}
            <span class="pill">⚪ {{ team.maxPlayers - team.players|length }} place(s)</span>
          {% endif %}
        </div>
        <div class="muted" style="font-size:13px;line-height:1.5;">
          Profil équipe ArenaMind • onglets membres / invitations / historique
        </div>
      </div>
    </div>

    <div class="tabs">
      <a class="btn tabBtn active" data-tab="members"><i class="fa-solid fa-users"></i> Membres</a>
      <a class="btn tabBtn" data-tab="invites"><i class="fa-solid fa-envelope"></i> Invitations</a>
      <a class="btn tabBtn" data-tab="history"><i class="fa-solid fa-clock-rotate-left"></i> Historique</a>
    </div>

    <div id="tab-members" class="tabPanel">
      <div class="grid">
        {% for member in team.players %}
          <div class="card" style="padding:14px;">
            <div class="member">
              {% if member.avatarName %}
                <img class="avatar" src="{{ asset('images/player-avatars/' ~ member.avatarName) }}" alt="{{ member.nickname }}">
              {% else %}
                <div class="avatar" style="display:flex;align-items:center;justify-content:center;">👤</div>
              {% endif %}
              <div style="flex:1;">
                <div style="font-weight:1000;">{{ member.nickname }}</div>
                <div class="muted" style="font-size:12px;margin-top:4px;">
                  {{ member.game|upper }}{% if member.rank %} • {{ member.rank }}{% endif %}
                </div>
                <div style="margin-top:8px;display:flex;gap:8px;flex-wrap:wrap;">
                  {% if member.discordId %}
                    <span class="miniBadge"><i class="fa-brands fa-discord"></i> ✓</span>
                  {% else %}
                    <span class="miniBadge"><i class="fa-brands fa-discord"></i> ✗</span>
                  {% endif %}
                  {% if member.riotGameName %}
                    <span class="miniBadge">Riot ✓</span>
                  {% else %}
                    <span class="miniBadge">Riot ✗</span>
                  {% endif %}
                </div>
              </div>
              <div style="display:flex;gap:8px;flex-wrap:wrap;">
                <a class="btn" href="{{ path('app_player_show', {'id': member.id}) }}"><i class="fa-solid fa-user"></i></a>
                <a class="btn" href="#" title="Défier">⚔️</a>
              </div>
            </div>
          </div>
        {% else %}
          <div class="muted">Aucun membre.</div>
        {% endfor %}

        {% if team.players|length < team.maxPlayers %}
          <div class="card" style="padding:14px;border-color:rgba(34,197,94,.35);">
            <div style="display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;">
              <div>
                <div style="font-weight:1000;">⚪ Places disponibles</div>
                <div class="muted" style="font-size:12px;margin-top:6px;">
                  {{ team.maxPlayers - team.players|length }} place(s) libre(s)
                </div>
              </div>
              <a class="btn btnPrimary" href="{{ path('team_invitations', {'id': team.id}) }}"><i class="fa-solid fa-user-plus"></i> Inviter un joueur</a>
            </div>
          </div>
        {% endif %}
      </div>
    </div>

    <div id="tab-invites" class="tabPanel" style="display:none;">
      <div class="card" style="padding:14px;">
        <div style="font-weight:1000;margin-bottom:6px;">📨 Invitations (gestion)</div>
        <div class="muted" style="font-size:13px;line-height:1.6;">
          Pour inviter des joueurs + voir les invitations en attente, utilise la page dédiée.
        </div>
        <div style="margin-top:12px;">
          <a class="btn btnPrimary" href="{{ path('team_invitations', {'id': team.id}) }}"><i class="fa-solid fa-user-plus"></i> Ouvrir Invitations</a>
        </div>
      </div>
    </div>

    <div id="tab-history" class="tabPanel" style="display:none;">
      <div class="card" style="padding:14px;">
        <div class="muted">Historique à venir…</div>
      </div>
    </div>

    {% if is_granted('ROLE_CAPTAIN') %}
      <div style="margin-top:14px;">
        {{ include('team/_delete_form.html.twig') }}
      </div>
    {% endif %}
  </div>
</div>

<script>
  (function(){
    const btns = document.querySelectorAll('.tabBtn');
    const panels = {
      members: document.getElementById('tab-members'),
      invites: document.getElementById('tab-invites'),
      history: document.getElementById('tab-history'),
    };
    btns.forEach(b=>{
      b.addEventListener('click', (e)=>{
        e.preventDefault();
        const key = b.getAttribute('data-tab');
        btns.forEach(x=>x.classList.remove('active'));
        b.classList.add('active');
        Object.keys(panels).forEach(k=>panels[k].style.display = (k===key?'block':'none'));
      });
    });
  })();
</script>
{% endblock %}