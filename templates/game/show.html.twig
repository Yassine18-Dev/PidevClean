{% extends 'front/base_front.html.twig' %}

{% block title %}ArenaMind • Détails du jeu{% endblock %}

{% block body %}
<section class="section">
  <div class="panel am-wrap">

    <div class="am-head">
      <h1>Détails du jeu</h1>
      <div class="am-sub">Informations</div>
    </div>

    {# Cards infos #}
    <div class="am-grid">

      <div class="am-card">
        <div class="am-label">ID UNIQUE</div>
        <div class="am-value">#{{ game.id }}</div>
      </div>

      <div class="am-card">
        <div class="am-label">NOM DU JEU</div>
        <div class="am-value">{{ game.name }}</div>
      </div>

      <div class="am-card">
        <div class="am-label">CAPACITÉ MAX</div>
        <div class="am-value">{{ game.maxPlayers }} Joueurs</div>
      </div>

      {# ✅ IMAGE CARD #}
      <div class="am-card am-card-image">
        <div class="am-label">IMAGE</div>
        <div class="am-image">
          <img
            src="{{ game.imageUrl }}"
            alt="{{ game.name }}"
            loading="lazy"
            onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1542751371-adc38448a05e?auto=format&fit=crop&w=1200&q=80';"
          />
        </div>
      </div>

    </div>

    {# Buttons full-width like your screenshot #}
    <div class="am-actions">
      <a class="am-btn am-btn-ghost" href="{{ path('app_game_index') }}">Retour</a>
      <a class="am-btn am-btn-primary" href="{{ path('app_game_edit', {'id': game.id}) }}">Edit</a>

      <form method="post"
            action="{{ path('app_game_delete', {'id': game.id}) }}"
            onsubmit="return confirm('Supprimer ce jeu ?');">
        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ game.id) }}">
        <button class="am-btn am-btn-danger" type="submit">Supprimer</button>
      </form>
    </div>

  </div>
</section>

<style>
  .am-wrap{padding:18px;}
  .am-head{text-align:center;margin-bottom:14px;}
  .am-head h1{margin:0;font-size:52px;line-height:1;color:#a855f7;font-weight:900;}
  .am-sub{margin-top:10px;color:#cbd5f5;opacity:.9;font-weight:800;}

  .am-grid{
    display:grid;
    grid-template-columns: repeat(4, 1fr);
    gap:14px;
    margin-top:18px;
    margin-bottom:18px;
  }

  .am-card{
    background:rgba(20,24,60,.25);
    border:1px solid rgba(49,46,129,.35);
    border-radius:18px;
    padding:18px;
    min-height:140px;
    display:flex;
    flex-direction:column;
    justify-content:center;
    text-align:center;
  }

  .am-label{
    font-weight:900;
    letter-spacing:.08em;
    color:#cbd5f5;
    opacity:.85;
    font-size:13px;
    margin-bottom:10px;
  }

  .am-value{
    font-size:34px;
    font-weight:900;
    color:#fff;
  }

  .am-card-image{padding:14px;}
  .am-image{
    width:100%;
    height:110px;
    border-radius:14px;
    overflow:hidden;
    border:1px solid rgba(168,85,247,.25);
    background:#0b0f2e;
  }
  .am-image img{
    width:100%;
    height:100%;
    object-fit:cover;
    display:block;
  }

  .am-actions{display:grid;gap:14px;margin-top:8px;}
  .am-btn{
    width:100%;
    display:flex;
    align-items:center;
    justify-content:center;
    padding:18px 16px;
    border-radius:999px;
    font-weight:900;
    color:#fff;
    text-decoration:none;
    border:1px solid transparent;
    cursor:pointer;
  }
  .am-btn-primary{background:linear-gradient(90deg,var(--purple),var(--blue));}
  .am-btn-ghost{background:linear-gradient(90deg,rgba(168,85,247,.45),rgba(59,130,246,.45)); border:1px solid rgba(168,85,247,.25);}
  .am-btn-danger{background:linear-gradient(90deg,rgba(220,38,38,.85),rgba(59,130,246,.35)); border:1px solid rgba(220,38,38,.35);}

  .am-btn:hover{opacity:.96;transform:translateY(-1px);}

  @media (max-width: 1100px){
    .am-grid{grid-template-columns: repeat(2, 1fr);}
  }
  @media (max-width: 700px){
    .am-head h1{font-size:38px;}
    .am-grid{grid-template-columns: 1fr;}
    .am-value{font-size:28px;}
    .am-image{height:160px;}
  }
</style>
{% endblock %}