{% extends 'front/base_front.html.twig' %}

{% block title %}ArenaMind • Explore Games{% endblock %}

{% block body %}
<section class="section">
  <div class="panel am-explore-wrap">

    <div class="am-explore-head">
      <h1>🌐 Explore Games — RAWG API</h1>
      <p class="am-explore-sub">Découvrez des milliers de jeux. Cliquez sur un titre pour voir toutes ses informations.</p>
    </div>

    {# Flash / Error RAWG #}
    {% if error %}
      <div class="am-alert">{{ error }}</div>
    {% endif %}

    {# Search #}
    <form method="get" class="am-search">
      <input
        type="text"
        name="search"
        value="{{ search }}"
        placeholder="Rechercher (ex: Valorant, FIFA, Minecraft)..."
      />
      <button class="am-btn am-btn-primary" type="submit">🔎 Rechercher</button>
    </form>

    <div class="am-count">
      {{ count|number_format(0, ',', ' ') }} jeux disponibles sur RAWG — page {{ page }}
    </div>

    {# Cards #}
    <div class="am-grid">
      {% for g in rawgGames %}
        <a class="am-card" href="{{ path('app_game_explore_detail', { rawgId: g.id }) }}">
          <div class="am-img">
            <img
              src="{{ g.background_image ?: 'https://images.unsplash.com/photo-1542751371-adc38448a05e?auto=format&fit=crop&w=1200&q=80' }}"
              alt="{{ g.name }}"
              loading="lazy"
              onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1542751371-adc38448a05e?auto=format&fit=crop&w=1200&q=80';"
            >
          </div>

          <div class="am-body">
            <div class="am-title">{{ g.name }}</div>
            <div class="am-meta">
              {% if g.released %}<span>📅 {{ g.released }}</span>{% endif %}
              {% if g.rating is defined %}<span>⭐ {{ g.rating }}</span>{% endif %}
            </div>
          </div>
        </a>
      {% else %}
        <div class="am-empty">Aucun résultat.</div>
      {% endfor %}
    </div>

    {# Pagination #}
    <div class="am-pager">
      {% if hasPrev %}
        <a class="am-btn am-btn-ghost"
           href="{{ path('app_game_explore', { search: search, page: page - 1 }) }}">
          ← Page précédente
        </a>
      {% endif %}

      {% if hasNext %}
        <a class="am-btn am-btn-ghost"
           href="{{ path('app_game_explore', { search: search, page: page + 1 }) }}">
          Page suivante →
        </a>
      {% endif %}
    </div>

  </div>
</section>

<style>
  .am-explore-wrap{padding:18px;}
  .am-explore-head{text-align:center;margin-bottom:14px;}
  .am-explore-head h1{margin:0;font-size:44px;line-height:1.1;color:#a855f7;font-weight:900;}
  .am-explore-sub{margin:12px 0 0;color:#cbd5f5;opacity:.9;font-weight:700}

  .am-alert{
    margin:12px 0;
    padding:12px 14px;
    border-radius:14px;
    background:rgba(220,38,38,.12);
    border:1px solid rgba(220,38,38,.30);
    color:#fecaca;
    font-weight:800;
  }

  .am-search{display:grid;grid-template-columns:1fr auto;gap:10px;align-items:center;margin:18px 0 10px;}
  .am-search input{
    width:100%;
    padding:14px 16px;
    border-radius:16px;
    background:#0b0f2e;
    border:1px solid rgba(49,46,129,.45);
    color:#fff;
    outline:none;
  }

  .am-btn{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    padding:12px 16px;
    border-radius:16px;
    font-weight:900;
    color:#fff;
    text-decoration:none;
    border:1px solid transparent;
    cursor:pointer;
    white-space:nowrap;
  }
  .am-btn-primary{background:linear-gradient(90deg,var(--purple),var(--blue));}
  .am-btn-ghost{background:rgba(168,85,247,.12);border:1px solid rgba(168,85,247,.25);}
  .am-btn:hover{opacity:.96;transform:translateY(-1px);}

  .am-count{color:#cbd5f5;font-weight:800;margin:10px 0 14px;}

  /* ✅ ICI: images plus petites */
  .am-grid{
    display:grid;
    grid-template-columns:repeat(4, 1fr);
    gap:12px;
  }

  .am-card{
    background:rgba(20,24,60,.45);
    border:1px solid rgba(49,46,129,.35);
    border-radius:18px;
    overflow:hidden;
    text-decoration:none;
    transition:.15s transform, .15s opacity;
  }
  .am-card:hover{transform:translateY(-3px);opacity:.98;}

  /* ✅ image height réduite (au lieu de très grande) */
  .am-img{
    height:120px;              /* ← change ici si tu veux encore plus petit (ex: 90px) */
    overflow:hidden;
    border-bottom:1px solid rgba(49,46,129,.35);
    background:#0b0f2e;
  }
  .am-img img{
    width:100%;
    height:100%;
    object-fit:cover;
    display:block;
  }

  .am-body{padding:12px;}
  .am-title{font-weight:900;color:#fff;font-size:15px;line-height:1.3;}
  .am-meta{margin-top:8px;display:flex;gap:10px;flex-wrap:wrap;color:#cbd5f5;opacity:.9;font-weight:700;font-size:12px;}

  .am-empty{padding:18px;color:#cbd5f5;opacity:.9;font-weight:800;}

  .am-pager{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin-top:18px;}

  @media (max-width: 1200px){
    .am-grid{grid-template-columns:repeat(3, 1fr);}
  }
  @media (max-width: 900px){
    .am-grid{grid-template-columns:repeat(2, 1fr);}
    .am-search{grid-template-columns:1fr;}
  }
  @media (max-width: 520px){
    .am-grid{grid-template-columns:1fr;}
    .am-explore-head h1{font-size:32px;}
    .am-img{height:140px;}
  }
</style>
{% endblock %}  