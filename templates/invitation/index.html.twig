{% extends 'front/base_front.html.twig' %}

{% block title %}My Invitations{% endblock %}

{% block body %}
<div class="am-container" style="max-width:980px; margin:24px auto;">
  <div class="am-card">
    <div class="am-card__head" style="display:flex; justify-content:space-between; align-items:center;">
      <div style="display:flex; gap:10px; align-items:center;">
        <span style="font-size:18px;">🔔</span>
        <div>
          <div style="font-weight:900;">MY INVITATIONS</div>
          <div style="opacity:.8; font-size:12px;">Pending: {{ pendingInvitations|length }}</div>
        </div>
      </div>
      <div class="mb-3" style="margin-bottom:0 !important;">
          <a href="{{ path('profile_index') }}" class="btn btn-outline-secondary" style="display:inline-flex; align-items:center; gap:8px; padding:8px 16px; border-radius:8px; border:1px solid rgba(255,255,255,0.2); color:#fff; text-decoration:none;">
              <i class="fas fa-arrow-left"></i> Retour au profil
          </a>
      </div>
    </div>

    <div class="am-card__body">
      {% if pendingInvitations is empty %}
        <div style="opacity:.85;">No pending invitations.</div>
      {% else %}
        <div style="display:flex; flex-direction:column; gap:12px;">
          {% for inv in pendingInvitations %}
            <div class="am-invite-card">
              <div style="display:flex; justify-content:space-between; gap:10px; flex-wrap:wrap;">
                <div>
                  <div style="font-weight:900;">{{ inv.team.name }} invites you</div>
                  <div style="opacity:.85; font-size:13px; margin-top:4px;">
                    🕒 Expires in {{ expiresIn(inv) }} day(s)
                  </div>
                </div>
                <div style="display:flex; gap:8px;">
                  <form method="post" action="{{ path('invitation_accept', {id: inv.id}) }}">
                    <button class="am-btn am-btn--success" type="submit">✓ Accept</button>
                  </form>
                  <form method="post" action="{{ path('invitation_decline', {id: inv.id}) }}">
                    <button class="am-btn am-btn--danger" type="submit">✗ Decline</button>
                  </form>
                  <a class="am-btn" href="{{ path('team_show', {id: inv.team.id}) }}">👥 View Team</a>
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
</div>

<style>
  .am-invite-card{
    background: rgba(255,255,255,.04);
    border: 1px solid rgba(255,255,255,.08);
    border-radius: 12px;
    padding: 12px;
    transition: transform .15s ease, box-shadow .15s ease;
  }
  .am-invite-card:hover{
    transform: scale(1.01);
    box-shadow: 0 0 18px rgba(0,168,255,.14);
  }
</style>
{% endblock %}