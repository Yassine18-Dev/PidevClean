{% extends 'front/base_front.html.twig' %}
{% block title %}ArenaMind • Invitations{% endblock %}

{% block body %}
<style>
  .wrap{max-width:1100px;margin:0 auto;}
  .card{background:rgba(11,15,46,.55); border:1px solid rgba(49,46,129,.55); border-radius:16px; padding:14px;}
  .btn{display:inline-flex; align-items:center; justify-content:center; padding:10px 14px; border-radius:14px; text-decoration:none; font-weight:900; font-size:13px; border:1px solid rgba(49,46,129,.55); background:rgba(5,8,20,.45); color:#fff;}
  .btn:hover{opacity:.95}
  .btnPrimary{border:none; background:linear-gradient(90deg,var(--purple),var(--blue));}
  .btnDanger{border:none; background:linear-gradient(90deg,#ef4444,#b91c1c);}
  .muted{color:var(--muted);}
</style>

<div class="wrap">
  <div style="display:flex; justify-content:space-between; align-items:center; gap:10px; flex-wrap:wrap; margin-bottom:14px;">
    <div>
      <div style="font-weight:1000; font-size:20px;">🔔 Mes invitations</div>
      <div class="muted" style="font-size:13px;">Réponds aux invitations en attente (expire après 7 jours)</div>
    </div>
    <a class="btn" href="{{ path('ui_profile') }}">← Retour au profil</a>
  </div>

  <div class="card">
    {% if invitations|length == 0 %}
      <div class="muted">Aucune invitation en attente.</div>
    {% else %}
      <div style="display:grid; gap:10px;">
        {% for inv in invitations %}
          {% set team = inv.team %}
          <div style="padding:12px; border-radius:14px; border:1px solid rgba(49,46,129,.45); background:rgba(5,8,20,.35);">
            <div style="display:flex; align-items:center; justify-content:space-between; gap:12px; flex-wrap:wrap;">
              <div>
                <div style="font-weight:1000;">{{ team.name }} ({{ team.game|upper }})</div>
                <div class="muted" style="font-size:12px; margin-top:4px;">
                  👥 {{ team.players|length }}/{{ team.maxPlayers }} • Invité le {{ inv.createdAt|date('d/m/Y') }}
                  • Expire le {{ inv.expiresAt ? inv.expiresAt|date('d/m/Y') : '—' }}
                </div>
              </div>
              <div style="display:flex; gap:8px; flex-wrap:wrap;">
                <a class="btn" href="{{ path('app_team_show', {id: team.id}) }}">👥 Voir équipe</a>
                <form method="post" action="{{ path('invitation_accept', {id: inv.id}) }}">
                  <button class="btn btnPrimary" type="submit">✓ ACCEPTER</button>
                </form>
                <form method="post" action="{{ path('invitation_decline', {id: inv.id}) }}">
                  <button class="btn btnDanger" type="submit">✗ REFUSER</button>
                </form>
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</div>
{% endblock %}
