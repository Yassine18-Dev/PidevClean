{# ArenaMind - styles communs (simple, sans dépendance) #}
<style>
  :root{
    --am-bg: #0B1020;
    --am-card: rgba(255,255,255,.06);
    --am-border: rgba(255,255,255,.12);
    --am-text: rgba(255,255,255,.92);
    --am-muted: rgba(255,255,255,.62);
    --am-primary: #7C3AED;
    --am-primary-2: #22D3EE;
  }

  .am-page{
    min-height: calc(100vh - 80px);
    padding: 32px 16px;
    background:
      radial-gradient(900px 500px at 15% 10%, rgba(124,58,237,.28), transparent 55%),
      radial-gradient(900px 500px at 85% 15%, rgba(34,211,238,.22), transparent 55%),
      linear-gradient(180deg, #0b1020 0%, #070a13 100%);
  }

  .am-shell{ max-width: 1100px; margin: 0 auto; }

  .am-card{
    background: var(--am-card);
    border: 1px solid var(--am-border);
    border-radius: 18px;
    box-shadow: 0 18px 60px rgba(0,0,0,.35);
    overflow: hidden;
    backdrop-filter: blur(10px);
  }

  .am-card__header{
    padding: 18px 18px 0 18px;
    display:flex; align-items:flex-start; justify-content:space-between; gap:12px;
  }

  .am-title{ color: var(--am-text); font-weight: 800; font-size: 22px; line-height: 1.2; margin:0; }
  .am-subtitle{ color: var(--am-muted); margin-top: 6px; font-size: 13px; }

  .am-card__body{ padding: 18px; }

  .am-actions{ display:flex; gap:10px; flex-wrap:wrap; justify-content:flex-end; }

  .am-btn{
    display:inline-flex; align-items:center; gap:8px;
    padding: 10px 16px;
    border-radius: 12px;
    border: 1px solid var(--am-border);
    color: var(--am-text);
    text-decoration:none;
    background: rgba(255,255,255,.05);
    transition: all .2s cubic-bezier(0.4, 0, 0.2, 1);
    font-weight: 700;
    font-size: 13px;
    backdrop-filter: blur(4px);
  }
  .am-btn:hover{ 
    background: rgba(255,255,255,.1); 
    transform: translateY(-2px);
    border-color: rgba(255,255,255,.3);
    box-shadow: 0 4px 20px rgba(0,0,0,0.3);
  }
  .am-btn--primary{
    border: none;
    background: linear-gradient(135deg, #7C3AED 0%, #a855f7 50%, #22D3EE 100%);
    box-shadow: 0 4px 15px rgba(124,58,237,0.3);
    color: #fff;
  }
  .am-btn--primary:hover{
    box-shadow: 0 6px 25px rgba(124,58,237,0.5), 0 0 10px rgba(34,211,238,0.3);
    opacity: 0.95;
  }
  .am-btn--outline-purple{
    border-color: rgba(124,58,237,.5);
    background: rgba(124,58,237,.05);
    color: #c4b5fd;
  }
  .am-btn--outline-purple:hover{
    background: rgba(124,58,237,.15);
    border-color: #a78bfa;
    box-shadow: 0 0 15px rgba(124,58,237,0.2);
  }

  .am-table{
    width:100%;
    border-collapse: collapse;
    overflow:hidden;
    border-radius: 14px;
    border: 1px solid var(--am-border);
    background: rgba(0,0,0,.18);
  }
  .am-table th, .am-table td{
    padding: 12px 12px;
    border-bottom: 1px solid rgba(255,255,255,.08);
    color: var(--am-text);
    font-size: 13px;
    vertical-align: middle;
  }
  .am-table th{
    color: rgba(255,255,255,.80);
    font-weight: 800;
    background: rgba(255,255,255,.03);
    text-align:left;
    white-space: nowrap;
  }
  .am-table tr:last-child td{ border-bottom: none; }
  .am-muted{ color: var(--am-muted); }

  .am-toolbar{
    display:flex; gap:10px; align-items:center; justify-content:space-between;
    margin: 0 0 14px 0; flex-wrap:wrap;
  }
  .am-input{
    padding: 10px 12px;
    border-radius: 12px;
    border: 1px solid var(--am-border);
    background: rgba(0,0,0,.22);
    color: var(--am-text);
    min-width: 260px;
    outline: none;
  }
  .am-input::placeholder{ color: rgba(255,255,255,.45); }
  .am-pill{
    padding: 6px 10px;
    border-radius: 999px;
    border: 1px solid var(--am-border);
    background: rgba(255,255,255,.04);
    color: rgba(255,255,255,.85);
    font-size: 12px;
    font-weight: 700;
  }

  .am-select{
    padding: 10px 12px;
    border-radius: 12px;
    border: 1px solid var(--am-border);
    background: rgba(0,0,0,.22);
    color: var(--am-text);
    outline: none;
    width: 100%;
    cursor: pointer;
  }
  .am-select option{ background: #0B1020; color: var(--am-text); }

  .am-form-grid{ display: grid; grid-template-columns: 1fr; gap: 16px; margin-bottom: 20px; }

  .am-form-row label{
    display: block;
    font-size: 13px;
    font-weight: 700;
    color: rgba(255,255,255,.80);
    margin-bottom: 6px;
  }
  .am-form-row .am-input,
  .am-form-row .am-select{ margin: 0; }

.am-errors{margin:8px 0 0;padding:12px 16px;list-style:none;background:rgba(239,68,68,.1);border-left:3px solid #ef4444;border-radius:8px;color:#fca5a5;font-size:13px;font-weight:600;}
.am-errors li{margin:0;}
.am-img-sm{height:100px !important;}
.am-card-compact .body{padding:10px;}
.am-table tr:hover{background:rgba(168,85,247,.05);}
.am-table td{vertical-align:middle;}

  .am-formActions{
    display: flex;
    gap: 10px;
    margin-top: 10px;
    flex-wrap: wrap;
    align-items: center;
  }

  .am-btnPrimary{
    display:inline-flex; align-items:center; gap:8px;
    padding: 10px 16px;
    border-radius: 12px;
    border: none;
    color: #fff;
    text-decoration:none;
    background: linear-gradient(135deg, rgba(124,58,237,.75), rgba(34,211,238,.45));
    font-weight: 800;
    font-size: 13px;
    cursor: pointer;
    transition: transform .08s ease, opacity .15s ease;
  }
  .am-btnPrimary:hover{ opacity:.92; transform: translateY(-1px); }

  .am-tableWrap{ overflow-x:auto; }

  .am-help{
    color: var(--am-muted);
    font-size: 13px;
    margin: 0 0 16px 0;
  }
</style>
