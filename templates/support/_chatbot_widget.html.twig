{# 
  Minimal Twig chatbot widget component
  
  Include this in your main layout:
  {% include 'support/_chatbot_widget.html.twig' %}
#}
<div class="chatbot-floating-btn" id="chatbotOpenBtn" title="Open AI Chat">🤖</div>

<div class="chatbot-widget" id="chatbotWidget" style="display:none;">
  <div class="chatbot-header">
    <span>🤖 AI Support Assistant</span>
    <button class="chatbot-close-btn" id="chatbotCloseBtn" title="Close chat">✕</button>
  </div>

  <div class="chatbot-messages" id="chatbotMessages">
    <div class="chatbot-msg chatbot-msg--ai">
      <div class="chatbot-bubble">
        <strong>👋 Hello!</strong> I'm your AI support assistant. Ask me anything or I'll guide you to create a support ticket!
      </div>
    </div>
  </div>

  <div class="chatbot-typing" id="chatbotTyping" style="display:none;">
    <div class="chatbot-typing-indicator">
      <span></span><span></span><span></span>
    </div>
  </div>

  <form class="chatbot-input-bar" id="chatbotForm">
    <input 
      type="text" 
      id="chatbotInput" 
      class="chatbot-input" 
      placeholder="Type your message..." 
      autocomplete="off" 
      maxlength="2000"
      aria-label="Chat message input"
    >
    <button 
      type="submit" 
      class="chatbot-send-btn" 
      id="chatbotSendBtn" 
      title="Send message (Enter)"
      aria-label="Send message"
    >➤</button>
  </form>

  <div class="chatbot-footer">
    <button type="button" class="chatbot-clear-btn" id="chatbotClearBtn" title="Clear conversation">
      🧹 Clear Chat
    </button>
  </div>
</div>

<link rel="stylesheet" href="{{ asset('css/chatbot.css') }}">
<script src="{{ asset('js/chatbot.js') }}" defer></script>
