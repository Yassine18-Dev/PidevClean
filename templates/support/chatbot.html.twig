<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>AI Chat • ArenaMind Support</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="stylesheet" href="{{ asset('css/support.css') }}">
  <style>
    body { background: var(--bg1); color: var(--text); font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; }
  </style>
</head>
<body class="support-body chatbot-body">

  <nav class="user-nav">
    <a href="{{ path('support_role_select') }}" class="user-nav-logo">🛡️ ArenaMind Support</a>
    <div class="user-nav-links">
      <a href="{{ path('support_user_tickets') }}" class="user-nav-link">🎫 My Tickets</a>
      <a href="{{ path('support_user_ticket_new') }}" class="user-nav-link">➕ New Ticket</a>
      <a href="{{ path('support_chatbot') }}" class="user-nav-link active">🤖 AI Chat</a>
    </div>
  </nav>

  <div class="chat-container">
    <div class="chat-header">
      <div class="chat-header-icon">🤖</div>
      <div>
        <h2 class="chat-header-title">ArenaMind AI Assistant</h2>
        <p class="chat-header-status"><span class="status-dot online"></span> Online — Ready to help</p>
      </div>
    </div>

    <div class="chat-messages" id="chatMessages">
      {# Welcome message #}
      <div class="chat-msg chat-msg--bot">
        <div class="chat-avatar">🤖</div>
        <div class="chat-bubble">
          <p><strong>👋 Hello!</strong> I'm the ArenaMind Support Assistant.</p>
          <p>I can help you with:</p>
          <ul style="margin: 8px 0; padding-left: 20px;">
            <li>🔐 Account & login issues</li>
            <li>👥 Team management</li>
            <li>💳 Payment & orders</li>
            <li>🏆 Tournaments</li>
            <li>🛠️ Technical problems</li>
          </ul>
          <p>Ask me anything, or I'll guide you to create a support ticket!</p>
        </div>
      </div>
    </div>

    <div class="chat-typing" id="chatTyping" style="display:none;">
      <div class="chat-avatar">🤖</div>
      <div class="chat-bubble">
        <div class="typing-indicator">
          <span></span><span></span><span></span>
        </div>
      </div>
    </div>

    <form class="chat-input-bar" id="chatForm">
      <input type="text" id="chatInput" class="chat-input" placeholder="Type your message..." autocomplete="off" maxlength="2000">
      <button type="submit" class="chat-send-btn" id="chatSendBtn" title="Send message (Enter)">
        <span class="send-icon">➤</span>
      </button>
    </form>

    <div class="chat-suggestions" id="chatSuggestions">
      <p style="font-size: 12px; color: var(--text-muted); margin-bottom: 12px; text-align: center;">Quick questions</p>
      <button type="button" class="suggestion-chip">🔐 Login issues</button>
      <button type="button" class="suggestion-chip">🔑 Reset password</button>
      <button type="button" class="suggestion-chip">💳 Payment help</button>
      <button type="button" class="suggestion-chip">🏆 Tournaments</button>
      <button type="button" class="chat-clear-btn" id="chatClearBtn" style="float:right; margin-top:8px; background: var(--bg2); color: var(--text-muted); border: none; padding: 6px 12px; border-radius: 6px; cursor: pointer;">🧹 Clear Chat</button>
    </div>
  </div>

  <script>
  (() => {
    'use strict';

    const chatMessages = document.getElementById('chatMessages');
    const chatForm = document.getElementById('chatForm');
    const chatInput = document.getElementById('chatInput');
    const chatTyping = document.getElementById('chatTyping');
    const chatSuggestions = document.getElementById('chatSuggestions');
    const chatClearBtn = document.getElementById('chatClearBtn');
    const apiUrl = '{{ path("api_support_chat") }}';
    const suggestionButtons = chatSuggestions.querySelectorAll('.suggestion-chip');

    let history = [];
    let isLoading = false;

    // Event listeners
    chatForm.addEventListener('submit', handleFormSubmit);
    suggestionButtons.forEach(btn => {
      btn.addEventListener('click', () => sendMessage(btn.textContent.split(' ').slice(1).join(' ')));
    });
    chatClearBtn.addEventListener('click', clearChat);

    function handleFormSubmit(e) {
      e.preventDefault();
      const msg = chatInput.value.trim();
      if (msg) sendMessage(msg);
    }

    async function sendMessage(text) {
      if (isLoading) return;
      
      // Add user message to UI
      appendMessage(text, 'user');
      chatInput.value = '';
      chatInput.disabled = true;
      document.getElementById('chatSendBtn').disabled = true;
      chatSuggestions.style.display = 'none';
      isLoading = true;

      // Show typing indicator
      chatTyping.style.display = 'flex';
      scrollToBottom();

      try {
        const response = await fetch(apiUrl, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest',
          },
          body: JSON.stringify({ message: text, history: history }),
        });

        if (!response.ok) {
          const errorData = await response.json().catch(() => ({}));
          throw new Error(errorData.error || `API error: ${response.status}`);
        }

        const data = await response.json();
        chatTyping.style.display = 'none';

        if (data.reply) {
          appendMessage(data.reply, 'bot');
          
          // Update history for context
          history.push({ role: 'user', content: text });
          history.push({ role: 'assistant', content: data.reply });

          // Keep history manageable (last 20 messages = 10 exchanges)
          if (history.length > 20) {
            history = history.slice(-20);
          }
        } else {
          appendMessage('I received an empty response. Please try again.', 'bot');
        }

      } catch (err) {
        console.error('Chatbot error:', err);
        chatTyping.style.display = 'none';
        const errorMsg = err.message.includes('Failed to fetch')
          ? '🌐 Network error. Please check your connection and try again.'
          : '😟 I encountered an error. Please try again or create a support ticket.';
        appendMessage(errorMsg, 'bot');
      } finally {
        isLoading = false;
        chatInput.disabled = false;
        document.getElementById('chatSendBtn').disabled = false;
        chatInput.focus();
      }
    }

    function appendMessage(text, type) {
      const div = document.createElement('div');
      div.className = `chat-msg chat-msg--${type}`;

      const avatar = document.createElement('div');
      avatar.className = 'chat-avatar';
      avatar.textContent = type === 'user' ? '👤' : '🤖';

      const bubble = document.createElement('div');
      bubble.className = 'chat-bubble';

      // Safe formatting: handle markdown-like syntax
      let formatted = escapeHtml(text)
        .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
        .replace(/\*(.*?)\*/g, '<em>$1</em>')
        .replace(/\n/g, '<br>')
        .replace(/• /g, '• ');

      bubble.innerHTML = `<p>${formatted}</p>`;

      div.appendChild(avatar);
      div.appendChild(bubble);
      chatMessages.appendChild(div);
      scrollToBottom();
    }

    function clearChat() {
      // Reset history and UI
      history = [];
      chatMessages.innerHTML = `
        <div class="chat-msg chat-msg--bot">
          <div class="chat-avatar">🤖</div>
          <div class="chat-bubble">
            <p><strong>👋 Hello!</strong> I'm the ArenaMind Support Assistant.</p>
            <p>I can help you with:</p>
            <ul style="margin: 8px 0; padding-left: 20px;">
              <li>🔐 Account & login issues</li>
              <li>👥 Team management</li>
              <li>💳 Payment & orders</li>
              <li>🏆 Tournaments</li>
              <li>🛠️ Technical problems</li>
            </ul>
            <p>Ask me anything, or I'll guide you to create a support ticket!</p>
          </div>
        </div>
      `;
      chatSuggestions.style.display = '';
      chatInput.value = '';
      chatInput.disabled = false;
      document.getElementById('chatSendBtn').disabled = false;
      chatTyping.style.display = 'none';
      scrollToBottom();
    }

    function escapeHtml(text) {
      const map = {
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        '"': '&quot;',
        "'": '&#039;'
      };
      return text.replace(/[&<>"']/g, c => map[c]);
    }

    function scrollToBottom() {
      setTimeout(() => {
        chatMessages.scrollTop = chatMessages.scrollHeight;
      }, 0);
    }
  })();
  </script>

</body>
</html>

