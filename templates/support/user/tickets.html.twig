<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>My Tickets • ArenaMind Support</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="stylesheet" href="{{ asset('css/support.css') }}">
</head>
<body class="support-body">

  {# ═══ USER NAV ═══ #}
  <nav class="user-nav">
    <a href="{{ path('support_role_select') }}" class="user-nav-logo">🛡️ ArenaMind Support</a>
    <div class="user-nav-links">
      <a href="{{ path('support_user_tickets') }}" class="user-nav-link active">🎫 My Tickets</a>
      <a href="{{ path('support_user_ticket_new') }}" class="user-nav-link">➕ New Ticket</a>
      <a href="{{ path('support_chatbot') }}" class="user-nav-link">🤖 AI Chat</a>
      <a href="{{ path('support_role_select') }}" class="user-nav-link">↩️ Hub</a>
    </div>
  </nav>

  <div class="user-content">
    <div class="page-header">
      <h1>🎫 My Support Tickets</h1>
      <p class="page-subtitle">Track the status of your submitted tickets</p>
      <a href="{{ path('support_user_ticket_new') }}" class="action-btn" style="margin-top:12px;">➕ Create New Ticket</a>
    </div>

    {% for msg in app.flashes('success') %}
      <div class="flash flash-success">✅ {{ msg }}</div>
    {% endfor %}

    {# ═══ TICKETS GRID ═══ #}
    <div class="user-tickets-grid">
      {% for ticket in pagination %}
      <a href="{{ path('support_user_ticket_show', {id: ticket.id}) }}" class="user-ticket-card">
        <div class="utc-header">
          <span class="utc-id">#{{ ticket.id }}</span>
          <span class="status-badge status-{{ ticket.status }}">{{ ticket.statusLabel }}</span>
        </div>
        <h3 class="utc-subject">{{ ticket.subject }}</h3>
        <div class="utc-meta">
          <span class="category-badge" style="border-color:{{ ticket.category.color }}">{{ ticket.category.icon }} {{ ticket.category.name }}</span>
          <span class="priority-badge priority-{{ ticket.priority }}">{{ ticket.priorityLabel }}</span>
        </div>
        <div class="utc-date">{{ ticket.createdAt|date('M d, Y') }}</div>
      </a>
      {% else %}
      <div class="empty-state">
        <div class="empty-icon">🎫</div>
        <h3>No tickets yet</h3>
        <p>You haven't submitted any support tickets.</p>
        <a href="{{ path('support_user_ticket_new') }}" class="action-btn">Create Your First Ticket</a>
      </div>
      {% endfor %}
    </div>

    {# ═══ PAGINATION ═══ #}
    {% if pagination.totalItemCount > 0 %}
    <div class="pagination-bar">
      <span class="pagination-info">Page {{ pagination.currentPageNumber }} of {{ pagination.pageCount }}</span>
      <div class="pagination-links">
        {% if pagination.currentPageNumber > 1 %}
          <a href="{{ path('support_user_tickets', {page: pagination.currentPageNumber - 1}) }}" class="page-link">← Prev</a>
        {% endif %}
        {% for i in 1..pagination.pageCount %}
          {% if i == pagination.currentPageNumber %}
            <span class="page-link page-active">{{ i }}</span>
          {% else %}
            <a href="{{ path('support_user_tickets', {page: i}) }}" class="page-link">{{ i }}</a>
          {% endif %}
        {% endfor %}
        {% if pagination.currentPageNumber < pagination.pageCount %}
          <a href="{{ path('support_user_tickets', {page: pagination.currentPageNumber + 1}) }}" class="page-link">Next →</a>
        {% endif %}
      </div>
    </div>
    {% endif %}
  </div>

</body>
</html>
