{% extends 'support/base_support_admin.html.twig' %}
{% block title %}Tickets{% endblock %}

{% block body %}
<div class="page-header">
  <h1>🎫 Ticket Management</h1>
  <p class="page-subtitle">Search, filter, and manage support tickets</p>
</div>

{# ═══ FILTERS ═══ #}
<form method="GET" class="filters-bar">
  <input type="text" name="q" value="{{ q }}" placeholder="🔍 Search tickets..." class="filter-input filter-search">
  <select name="status" class="filter-input">
    <option value="">All Status</option>
    <option value="pending" {{ status == 'pending' ? 'selected' }}>Pending</option>
    <option value="in_progress" {{ status == 'in_progress' ? 'selected' }}>In Progress</option>
    <option value="resolved" {{ status == 'resolved' ? 'selected' }}>Resolved</option>
    <option value="rejected" {{ status == 'rejected' ? 'selected' }}>Rejected</option>
  </select>
  <select name="category" class="filter-input">
    <option value="">All Categories</option>
    {% for cat in categories %}
      <option value="{{ cat.id }}" {{ category == cat.id ? 'selected' }}>{{ cat.icon }} {{ cat.name }}</option>
    {% endfor %}
  </select>
  <button type="submit" class="btn-filter">Filter</button>
  <a href="{{ path('support_admin_tickets') }}" class="btn-filter btn-clear">Clear</a>
</form>

{# ═══ TICKET TABLE ═══ #}
<div class="table-card">
  <table class="data-table">
    <thead>
      <tr>
        <th>ID</th>
        <th>Subject</th>
        <th>Submitter</th>
        <th>Category</th>
        <th>Priority</th>
        <th>Status</th>
        <th>Created</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      {% for ticket in pagination %}
      <tr class="table-row">
        <td class="td-id">#{{ ticket.id }}</td>
        <td class="td-subject">
          <a href="{{ path('support_admin_ticket_show', {id: ticket.id}) }}">{{ ticket.subject|length > 45 ? ticket.subject|slice(0,45) ~ '...' : ticket.subject }}</a>
        </td>
        <td>{{ ticket.submitter.username }}</td>
        <td><span class="category-badge" style="border-color:{{ ticket.category.color }}">{{ ticket.category.icon }} {{ ticket.category.name }}</span></td>
        <td><span class="priority-badge priority-{{ ticket.priority }}">{{ ticket.priorityLabel }}</span></td>
        <td><span class="status-badge status-{{ ticket.status }}">{{ ticket.statusLabel }}</span></td>
        <td class="td-date">{{ ticket.createdAt|date('M d, Y') }}</td>
        <td><a href="{{ path('support_admin_ticket_show', {id: ticket.id}) }}" class="btn-action">View</a></td>
      </tr>
      {% else %}
      <tr><td colspan="8" class="empty-table">No tickets found.</td></tr>
      {% endfor %}
    </tbody>
  </table>
</div>

{# ═══ PAGINATION ═══ #}
{% if pagination.totalItemCount > 0 %}
<div class="pagination-bar">
  <span class="pagination-info">Showing {{ pagination.currentPageNumber }} of {{ pagination.pageCount }} pages ({{ pagination.totalItemCount }} tickets)</span>
  <div class="pagination-links">
    {% if pagination.currentPageNumber > 1 %}
      <a href="{{ path('support_admin_tickets', {page: pagination.currentPageNumber - 1, q: q, status: status, category: category}) }}" class="page-link">← Prev</a>
    {% endif %}
    {% for i in 1..pagination.pageCount %}
      {% if i == pagination.currentPageNumber %}
        <span class="page-link page-active">{{ i }}</span>
      {% else %}
        <a href="{{ path('support_admin_tickets', {page: i, q: q, status: status, category: category}) }}" class="page-link">{{ i }}</a>
      {% endif %}
    {% endfor %}
    {% if pagination.currentPageNumber < pagination.pageCount %}
      <a href="{{ path('support_admin_tickets', {page: pagination.currentPageNumber + 1, q: q, status: status, category: category}) }}" class="page-link">Next →</a>
    {% endif %}
  </div>
</div>
{% endif %}
{% endblock %}
